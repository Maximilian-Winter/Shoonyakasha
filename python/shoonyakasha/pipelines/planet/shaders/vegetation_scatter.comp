#version 450
//
// Places the vegetation for this frame: one workgroup per chunk ChunkDraws
// draws (its count first, then five words per draw, the slot last), of the
// planet (body 0), at least the coarsest level vegetation.lod.w, within the
// range of the camera.
//
// Each cube face is divided into vegetation.settings.z x settings.z cells
// in face coordinates, the same whatever the chunks are, and each cell has
// one candidate at a point jittered within it by a hash of the cell. A
// candidate belongs to the chunk whose face coordinates hold it, so each is
// considered once. Within the range it is kept by a draw from the hash
// against what grows at its point (biome.glsl's biomePlants, from the
// chunk's grid unmorphed): a tree by the biomes' tree chance (thinned in
// clearings, gathered in groves), else a bush by their bush chance within
// the bushes' range, none on beaches, rock, snow or the sea floor, scaled by
// settings.w. Beyond vegetation.thinning.x a tree is kept with a chance of
// (thinning.x / its distance)^2, a second draw from the hash, so the trees
// in view fit their kinds' instances. A tree is a conifer by the biomes'
// conifers' share, else an acacia by their acacias' share, else a
// broadleaf tree; a bush is a cactus by their cacti's share, else a shrub
// by their shrubs' share, else a bush (biomePlants' forms). Conifers and
// broadleaf trees are variant a or b by a draw. A kept plant stands on the
// chunk's surface as drawn (morph.glsl's morphed vertices, split along the
// chunk's quads' diagonals), its height shrinking to nothing over the last
// 15 % of the range, with a hashed size in its kind's range of heights, turn
// and tint, and its biomes' foliage colour (darker for conifers; the cactus
// colour for cacti). Trees are their detailed meshes within vegetation.lod.x,
// their impostors beyond. The draws from the hash come in the same order
// whatever is kept, so a plant keeps its form and size at any distance.
//
// Each kept plant takes the next instance of its kind (an atomic add on
// its draw's instance count in VegetationDraws, which the CPU sets to zero
// each frame); one past the kind's capacity is given back.
//

layout(local_size_x = 64) in;

#include "vegetation_scatter.glsl"

// The kinds (vegetation.glsl): each tree's near kind, its far kind the next.
const int KIND_CONIFER_A = 0;
const int KIND_CONIFER_B = 2;
const int KIND_BROADLEAF_A = 4;
const int KIND_BROADLEAF_B = 6;
const int KIND_ACACIA = 8;
const int KIND_BUSH = 10;
const int KIND_SHRUB = 11;
const int KIND_CACTUS = 12;
// Each kind's heights (m), lowest and highest.
const vec2 HEIGHTS[13] = vec2[13](vec2(9.0, 18.0), vec2(9.0, 18.0), vec2(12.0, 22.0), vec2(12.0, 22.0),
                                  vec2(7.0, 13.0), vec2(7.0, 13.0), vec2(9.0, 16.0), vec2(9.0, 16.0),
                                  vec2(5.0, 9.0), vec2(5.0, 9.0), vec2(1.2, 2.6), vec2(0.5, 1.3),
                                  vec2(2.5, 7.0));
const float FADE_START = 0.85;      // of the range: where heights start to shrink
const float MAX_TREE_CHANCE = 0.97;
const float CONIFER_SHADE = 0.6;    // a conifer's foliage, of its biomes' foliage colour
const float BROADLEAF_SHADE = 0.75;

void main() {
    ScatterChunk chunk;
    float range = vegetation.settings.y;
    if (vegetation.settings.x == 0.0 || !scatterChunk(gl_WorkGroupID.x, vegetation.lod.w, range, chunk)) return;
    float cells = vegetation.settings.z;
    int cu0, cv0;
    uint across, count;
    scatterCells(chunk, cells, cu0, cv0, across, count);
    float density = vegetation.settings.w;
    uint capacity = uint(vegetation.lod.z);

    for (uint k = gl_LocalInvocationID.x; k < count; k += 64u) {
        Candidate x;
        if (!scatterCandidate(chunk, cells, cu0, cv0, across, k, 0, range, x)) continue;
        float pick = nextRandom(x.hash);
        float thin = nextRandom(x.hash);
        float form = nextRandom(x.hash);
        float variant = nextRandom(x.hash);
        float grow = nextRandom(x.hash);
        float turn = 6.2831853 * nextRandom(x.hash);
        float tint = nextRandom(x.hash);
        if (pick >= density) continue;                                // chances are at most 1
        vec3 radial, normal, climate;
        float height;
        candidateGround(chunk, x, radial, height, normal, climate);
        vec3 leaf, grass, forms;
        vec4 plants = biomePlants(radial, height, normal, climate, leaf, grass, forms);
        float treeChance = density * min(plants.x, MAX_TREE_CHANCE);
        float bushChance = density * plants.z;
        int kind;
        vec3 foliage;
        if (pick < treeChance) {
            float full = vegetation.thinning.x;
            if (x.distance > full && thin * x.distance * x.distance >= full * full) continue;
            if (form < plants.y) {
                kind = variant < 0.6 ? KIND_CONIFER_A : KIND_CONIFER_B;
                foliage = leaf * CONIFER_SHADE;
            } else {
                bool acacia = (form - plants.y) / max(1.0 - plants.y, 1e-4) < forms.x;
                kind = acacia ? KIND_ACACIA : variant < 0.5 ? KIND_BROADLEAF_A : KIND_BROADLEAF_B;
                foliage = leaf * BROADLEAF_SHADE;
            }
            if (x.distance > vegetation.lod.x) kind += 1;
        } else if (pick < treeChance + bushChance && x.distance < vegetation.lod.y) {
            bool cactus = form < forms.z;
            bool shrub = !cactus && (form - forms.z) / max(1.0 - forms.z, 1e-4) < forms.y;
            kind = cactus ? KIND_CACTUS : shrub ? KIND_SHRUB : KIND_BUSH;
            foliage = cactus ? biomeCactus() : leaf * BROADLEAF_SHADE;
        } else {
            continue;
        }
        float size = mix(HEIGHTS[kind].x, HEIGHTS[kind].y, grow) * smoothstep(range, range * FADE_START, x.distance);
        if (size < 0.05) continue;
        vec3 drawn = candidateDrawn(chunk, x);
        uint at;
        if (!claimInstance(uint(kind), uint(kind) * capacity, capacity, at)) continue;
        instances.data[at] = vec4(drawn, size);
        instances.data[at + 1u] = vec4(cos(turn), sin(turn), tint, vegetationPackColour(foliage));
    }
}
