#version 450
//
// Places the vegetation for this frame: one workgroup per chunk ChunkDraws
// draws (its count first, then five words per draw, the slot last), of the
// planet (body 0), at least the coarsest level vegetation.lod.w, within the
// range of the camera.
//
// Each cube face is divided into vegetation.settings.z x settings.z cells
// in face coordinates, the same whatever the chunks are, and each cell has
// one candidate at a point jittered within it by a hash of the cell. A
// candidate belongs to the chunk whose face coordinates hold it, so each is
// considered once. Within the range it is kept by a draw from the hash
// against the layers at its point (biome.glsl's groundLayers, from the
// chunk's grid unmorphed): a tree where there is forest (and a few in grass
// and dry ground), a bush in grass and dry ground (and a few in forest),
// within their range, none on sand, rock, snow or the sea floor, scaled by
// settings.w. Conifers rather than broadleaf trees towards the poles and
// high up. A kept plant stands on the chunk's surface as drawn (morph.glsl's
// morphed vertices, split along the chunk's quads' diagonals), its height
// shrinking to nothing over the last 15 % of the range, with a hashed size,
// turn and tint. The detailed meshes within vegetation.lod.x, the simple
// ones beyond.
//
// Each kept plant takes the next instance of its kind (an atomic add on
// its draw's instance count in VegetationDraws, which the CPU sets to zero
// each frame); one past the kind's capacity is given back.
//

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform TerrainParams {
    vec4 continent;
    vec4 mountains;
    vec4 hills;
    vec4 seed;
    vec4 site;
    vec4 siteShape;
    vec4 detail;
} terrain;

#define VEGETATION_SET 0
#define VEGETATION_PARAMS 1
#include "vegetation.glsl"

layout(std430, set = 0, binding = 2) readonly buffer ChunkDraws {
    uint words[];
} chunkDraws;

layout(std430, set = 0, binding = 3) writeonly buffer VegetationInstances {
    vec4 data[];
} instances;

layout(std430, set = 0, binding = 4) buffer VegetationDraws {
    uint words[];
} draws;

struct ChunkInstance {
    vec4 origin;           // xyz: the chunk's centre minus the camera's position
    vec4 colour;
    vec4 morph;            // x: the parent's split distance; y: the levels above the chunk; z: its body
};

layout(std430, set = 1, binding = 0) readonly buffer ChunkInstances {
    ChunkInstance instances[];
} chunks;

#include "terrain.glsl"
#include "biome.glsl"
#include "morph.glsl"

const int KIND_CONIFER = 0;
const int KIND_BROADLEAF = 2;
const int KIND_BUSH = 4;
const float FADE_START = 0.85;      // of the range: where heights start to shrink

// The cube face whose normal is nearest the unit direction `d` (cube_sphere.FACES' order).
int faceOf(vec3 d) {
    vec3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) return d.x > 0.0 ? 0 : 1;
    if (a.y >= a.z) return d.y > 0.0 ? 2 : 3;
    return d.z > 0.0 ? 4 : 5;
}

uint nextHash(inout uint h) {
    h = h * 747796405u + 2891336453u;
    uint w = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    return (w >> 22u) ^ w;
}

float nextRandom(inout uint h) {
    return float(nextHash(h) & 0xFFFFFFu) / 16777216.0;
}

// The grid vertex (i, j) of the chunk at `base`, unmorphed.
ChunkVertex gridVertex(uint base, int i, int j) {
    return pool.vertices[base + uint(j * MORPH_ROW + i)];
}

// The three grid vertices around (fi, fj) (grid coordinates) and their
// weights, split along each quad's rising diagonal as the chunk's mesh is.
void gridTriangle(float fi, float fj, out ivec2 a, out ivec2 b, out ivec2 c, out vec3 w) {
    int i = clamp(int(floor(fi)), 0, MORPH_QUADS - 1);
    int j = clamp(int(floor(fj)), 0, MORPH_QUADS - 1);
    float x = clamp(fi - float(i), 0.0, 1.0), y = clamp(fj - float(j), 0.0, 1.0);
    a = ivec2(i, j);
    if (x >= y) {
        b = ivec2(i + 1, j);
        c = ivec2(i + 1, j + 1);
        w = vec3(1.0 - x, x - y, y);
    } else {
        b = ivec2(i + 1, j + 1);
        c = ivec2(i, j + 1);
        w = vec3(1.0 - y, x, y - x);
    }
}

void main() {
    uint group = gl_WorkGroupID.x;
    if (vegetation.settings.x == 0.0 || group >= chunkDraws.words[0]) return;
    uint slot = chunkDraws.words[4u + group * 5u + 4u];
    ChunkInstance chunk = chunks.instances[slot];
    if (int(chunk.morph.z) != 0 || chunk.morph.y < vegetation.lod.w) return;
    float range = vegetation.settings.y;
    uint base = slot * uint(MORPH_VERTICES);
    ChunkVertex first = gridVertex(base, 0, 0);
    ChunkVertex last = gridVertex(base, MORPH_QUADS, MORPH_QUADS);
    float halfDiagonal = 0.5 * length(last.positionU.xyz - first.positionU.xyz) + 50.0;
    if (length(chunk.origin.xyz) - halfDiagonal > range) return;

    float u0 = first.positionU.w, v0 = first.normalV.w, u1 = last.positionU.w, v1 = last.normalV.w;
    int face = faceOf(gridVertex(base, MORPH_QUADS / 2, MORPH_QUADS / 2).radialHeight.xyz);
    float cells = vegetation.settings.z;
    int cu0 = int(floor((u0 + 1.0) * 0.5 * cells)), cu1 = int(ceil((u1 + 1.0) * 0.5 * cells));
    int cv0 = int(floor((v0 + 1.0) * 0.5 * cells)), cv1 = int(ceil((v1 + 1.0) * 0.5 * cells));
    uint across = uint(max(cu1 - cu0, 0)), count = across * uint(max(cv1 - cv0, 0));
    float density = vegetation.settings.w;
    uint capacity = uint(vegetation.lod.z);

    for (uint k = gl_LocalInvocationID.x; k < count; k += 64u) {
        int cu = cu0 + int(k % across), cv = cv0 + int(k / across);
        uint h = terrainHash(ivec3(cu, cv, face));
        float pu = -1.0 + 2.0 * (float(cu) + nextRandom(h)) / cells;
        float pv = -1.0 + 2.0 * (float(cv) + nextRandom(h)) / cells;
        if (pu < u0 || pu >= u1 || pv < v0 || pv >= v1) continue;     // another chunk's
        float fi = (pu - u0) / (u1 - u0) * float(MORPH_QUADS);
        float fj = (pv - v0) / (v1 - v0) * float(MORPH_QUADS);
        ivec2 a, b, c;
        vec3 w;
        gridTriangle(fi, fj, a, b, c, w);
        ChunkVertex va = gridVertex(base, a.x, a.y), vb = gridVertex(base, b.x, b.y), vc = gridVertex(base, c.x, c.y);
        vec3 position = w.x * va.positionU.xyz + w.y * vb.positionU.xyz + w.z * vc.positionU.xyz;
        float distance = length(chunk.origin.xyz + position);
        if (distance > range) continue;
        float pick = nextRandom(h);
        if (pick > 0.95 * density) continue;                          // above the densest biome's chance
        vec3 radial = normalize(w.x * va.radialHeight.xyz + w.y * vb.radialHeight.xyz + w.z * vc.radialHeight.xyz);
        float height = w.x * va.radialHeight.w + w.y * vb.radialHeight.w + w.z * vc.radialHeight.w;
        vec3 normal = normalize(w.x * va.normalV.xyz + w.y * vb.normalV.xyz + w.z * vc.normalV.xyz);
        float weights[GROUND_LAYERS];
        vec3 colours[GROUND_LAYERS];
        groundLayers(radial, height, normal, weights, colours);
        if (height < 0.0) continue;
        float forest = weights[GROUND_FOREST], grass = weights[GROUND_GRASS], dry = weights[GROUND_DRY];
        float treeChance = density * (0.85 * forest + 0.04 * grass + 0.01 * dry);
        float bushChance = density * (0.10 * forest + 0.12 * grass + 0.05 * dry);
        int kind;
        float size;
        if (pick < treeChance) {
            float coniferShare = clamp(0.2 + smoothstep(0.35, 0.65, abs(radial.y)) + smoothstep(900.0, 1600.0, height),
                                       0.0, 1.0);
            bool conifer = nextRandom(h) < coniferShare;
            kind = conifer ? KIND_CONIFER : KIND_BROADLEAF;
            size = conifer ? mix(9.0, 18.0, nextRandom(h)) : mix(7.0, 13.0, nextRandom(h));
            if (distance > vegetation.lod.x) kind += 1;
        } else if (pick < treeChance + bushChance && distance < vegetation.lod.y) {
            kind = KIND_BUSH;
            size = mix(1.2, 2.6, nextRandom(h));
        } else {
            continue;
        }
        size *= smoothstep(range, range * FADE_START, distance);
        if (size < 0.05) continue;
        float turn = 6.2831853 * nextRandom(h);
        float tint = nextRandom(h);

        // On the surface as drawn.
        uint ia = base + uint(a.y * MORPH_ROW + a.x), ib = base + uint(b.y * MORPH_ROW + b.x);
        uint ic = base + uint(c.y * MORPH_ROW + c.x);
        ChunkVertex ma = morphedVertex(ia, slot, chunk.origin.xyz, chunk.morph);
        ChunkVertex mb = morphedVertex(ib, slot, chunk.origin.xyz, chunk.morph);
        ChunkVertex mc = morphedVertex(ic, slot, chunk.origin.xyz, chunk.morph);
        vec3 drawn = w.x * ma.positionU.xyz + w.y * mb.positionU.xyz + w.z * mc.positionU.xyz;

        uint index = atomicAdd(draws.words[uint(kind) * 5u + 1u], 1u);
        if (index >= capacity) {
            atomicAdd(draws.words[uint(kind) * 5u + 1u], 0xFFFFFFFFu);   // give it back
            continue;
        }
        uint at = (uint(kind) * capacity + index) * 2u;
        instances.data[at] = vec4(chunk.origin.xyz + drawn, size);
        instances.data[at + 1u] = vec4(cos(turn), sin(turn), tint, 0.0);
    }
}
