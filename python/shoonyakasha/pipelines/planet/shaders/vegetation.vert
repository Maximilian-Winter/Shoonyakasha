#version 450
//
// The vegetation's vertex shader: one instance of a kind's mesh
// (VegetationMesh, generated by shoonyakasha.planet.vegetation) per plant
// that vegetation_scatter.comp kept, from VegetationInstances by
// gl_InstanceIndex (the draw's first instance is its kind's first). The
// mesh's y is the plant's up, away from the planet's centre; it is scaled
// by the plant's height and turned about its up. Foliage (the normal's w)
// is tinted by the plant's tint, from 80 % to 115 % of its colour.
//

#define CAMERA_SET 0
#include "camera.glsl"
#define VEGETATION_SET 1
#define VEGETATION_PARAMS 0
#include "vegetation.glsl"

layout(std430, set = 1, binding = 1) readonly buffer VegetationInstances {
    vec4 data[];
} instances;

layout(location = 0) in vec4 inPosition;
layout(location = 1) in vec4 inNormal;     // w: 1 for foliage, 0 for wood
layout(location = 2) in vec4 inColour;

layout(location = 0) out vec3 fragNormal;
layout(location = 1) out vec3 fragColour;
layout(location = 2) out vec3 fragRelativePos;

void main() {
    vec4 placed = instances.data[gl_InstanceIndex * 2];
    vec4 look = instances.data[gl_InstanceIndex * 2 + 1];
    vec3 right, up, ahead;
    vegetationFrame(camera.cameraFromCentre.xyz, placed.xyz, look.xy, right, up, ahead);
    vec3 offset = (right * inPosition.x + up * inPosition.y + ahead * inPosition.z) * placed.w;
    vec3 relativePos = placed.xyz + offset;
    fragNormal = normalize(right * inNormal.x + up * inNormal.y + ahead * inNormal.z);
    fragColour = inColour.rgb * mix(1.0, mix(0.8, 1.15, look.z), inNormal.w);
    fragRelativePos = relativePos;
    gl_Position = camera.proj * camera.view * vec4(relativePos, 1.0);
}
