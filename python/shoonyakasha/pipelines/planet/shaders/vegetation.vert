#version 450
//
// The vegetation's vertex shader: one instance of a kind's mesh
// (VegetationMesh, generated by shoonyakasha.planet.vegetation) per plant
// that vegetation_scatter.comp or grass_scatter.comp kept, from
// VegetationInstances by gl_InstanceIndex (the draw's first instance is its
// kind's first). The mesh's y is the plant's up, away from the planet's
// centre; it is scaled by the plant's height, across by vegetationWidth,
// and turned about its up, except an impostor's quad, which faces the
// camera about its tree's bounding sphere (vegetationImpostor), handing
// the fragment shader its point in the tree's frame (fragLocal) and the
// camera's direction in it (fragTangent). In the wind (vegetation.wind, along the
// ground) a tree bends: every point of it, its impostor's too, moves along
// the wind by TRUNK_BEND of the plant's height times its height's share
// squared, swinging slowly (TRUNK_HZ); its branches and cards sway by
// BRANCH_SWAY of its height times their sway (the vertex's colour.g)
// (BRANCH_HZ, their phase colour.b); its cards flutter along their normal
// by FLUTTER m (FLUTTER_HZ); grass sways by GRASS_SWAY of its height times
// its height's share squared. Each scales with the wind's speed over
// WIND_FULL (at most WIND_MOST), its phase following the plant's place on
// the planet. A tree leans by its packed lean (vegetationLean): each point
// moves across by the lean times its height. The fragment shader gets the part, the
// texture's (u, v), the shade, the plant's colour (tinted from 80 % to
// 115 %, and warmer or cooler by HUE_SPREAD; white for bark) and the plant's frame (an impostor's facing the
// camera), the mesh's own position and an ore rock's resource; for a
// scan, its tangent turned with the plant and its material's cell in the
// scans' atlas (vegetationScanCell), its shade 1.
// Positions are jittered for the TAA pass (camera.glsl's jittered).
//

#define CAMERA_SET 0
#include "camera.glsl"
#define VEGETATION_SET 1
#define VEGETATION_PARAMS 0
#include "vegetation.glsl"

layout(std430, set = 1, binding = 1) readonly buffer VegetationInstances {
    vec4 data[];
} instances;

layout(location = 0) in vec4 inPosition;   // w: u
layout(location = 1) in vec4 inNormal;     // w: the part
layout(location = 2) in vec4 inColour;     // rgb: shade; w: v

layout(location = 0) out vec3 fragNormal;
layout(location = 1) out vec3 fragColour;
layout(location = 2) out vec3 fragRelativePos;
layout(location = 3) flat out int fragPart;
layout(location = 4) out vec2 fragUv;
layout(location = 5) out float fragShade;
layout(location = 6) flat out vec3 fragRight;
layout(location = 7) flat out vec3 fragUp;
layout(location = 8) flat out vec3 fragFacing;
layout(location = 9) flat out int fragOnMoon;
layout(location = 10) out vec3 fragLocal;
layout(location = 11) flat out int fragResource;   // an ore rock's resource id, 0 for anything else
layout(location = 12) out vec3 fragTangent;          // a scan's; zero for anything else
layout(location = 13) flat out vec4 fragCell;        // a scan's cell in the scans' atlas

const float HUE_SPREAD = 0.3;       // a plant's foliage warmer or cooler by up to half this, by its tint
const float TRUNK_BEND = 0.015;     // of the height, at the top
const float TRUNK_HZ = 0.2;
const float BRANCH_SWAY = 0.003;    // of the height, at a branch's tip
const float BRANCH_HZ = 0.7;
const float FLUTTER = 0.012;        // m
const float FLUTTER_HZ = 4.5;
const float GRASS_SWAY = 0.12;      // of the height, at the top
const float WIND_FULL = 15.0;       // m/s
const float WIND_MOST = 1.5;

void main() {
    vec4 placed = instances.data[gl_InstanceIndex * 2];
    vec4 look = instances.data[gl_InstanceIndex * 2 + 1];
    int part = int(inNormal.w + 0.5);
    float tint = vegetationTint(look.z);
    float width = vegetationWidth(tint);
    vec3 right, up, ahead;
    vegetationFrame(vegetationCameraFromCentre(look.w), placed.xyz, look.xy, right, up, ahead);
    vec3 offset, normal;
    vec3 local = inPosition.xyz, view = vec3(0.0);
    if (part == VEGETATION_PART_IMPOSTOR) {
        vec3 centre = placed.xyz + up * ((inPosition.y - inColour.y * inColour.z) * placed.w);
        vegetationImpostor(right, up, ahead, placed.w, width, inPosition, inColour.xyz, -centre, offset, local, view);
        normal = normalize(-centre);
    } else {
        offset = (right * inPosition.x * width + up * inPosition.y + ahead * inPosition.z * width) * placed.w;
        normal = normalize(right * inNormal.x / width + up * inNormal.y + ahead * inNormal.z / width);
    }
    vec3 wind = vegetation.wind.xyz - up * dot(vegetation.wind.xyz, up);
    float speed = length(wind);
    float strength = min(speed / WIND_FULL, WIND_MOST);
    vec3 along = speed > 1e-3 ? wind / speed : right;
    float phase = dot(camera.cameraFromCentre.xyz + placed.xyz, vec3(0.37, 0.53, 0.29));
    float t = camera.time * 6.2831853;
    if (part == VEGETATION_PART_BARK || part == VEGETATION_PART_CARD || part == VEGETATION_PART_IMPOSTOR) {
        float y = inPosition.y;
        vec2 lean = vegetationLean(look.z);
        offset += (right * lean.x + ahead * lean.y) * (y * placed.w);
        offset += along * (TRUNK_BEND * strength * y * y * placed.w * (0.75 + 0.25 * sin(t * TRUNK_HZ + phase)));
        if (part != VEGETATION_PART_IMPOSTOR) {
            float sway = inColour.g, own = inColour.b * 6.2831853 + phase;
            offset += along * (BRANCH_SWAY * strength * sway * placed.w * sin(t * BRANCH_HZ + own));
            if (part == VEGETATION_PART_CARD) {
                offset += normal * (FLUTTER * strength * sway * sin(t * FLUTTER_HZ + 7.0 * own));
            }
        }
    } else if (part == VEGETATION_PART_GRASS) {
        offset += along * (GRASS_SWAY * strength * inPosition.y * inPosition.y * placed.w * sin(t * 0.33 + phase));
    }
    vec3 relativePos = placed.xyz + offset;
    fragNormal = normal;
    float hue = fract(tint * 13.73) - 0.5;
    vec3 colour = vegetationUnpackColour(look.w) * mix(0.8, 1.15, tint)
                * vec3(1.0 + HUE_SPREAD * hue, 1.0, 1.0 - HUE_SPREAD * hue);
    fragColour = part == VEGETATION_PART_BARK ? vec3(1.0) : colour;
    fragRelativePos = relativePos;
    fragPart = part;
    fragUv = vec2(inPosition.w, inColour.w);
    fragShade = inColour.r;
    fragTangent = view;
    fragCell = vec4(0.0);
    if (part >= VEGETATION_PART_SCAN) {
        int cell;
        bool cutout;
        float sign;
        vegetationScanPart(part, cell, cutout, sign);
        fragTangent = normalize(right * inColour.x * width + up * inColour.y + ahead * inColour.z * width);
        fragCell = vegetationScanCell(cell);
        fragShade = 1.0;
    }
    fragRight = right;
    fragUp = up;
    fragFacing = ahead;
    fragOnMoon = vegetationOnMoon(look.w) ? 1 : 0;
    fragLocal = local;
    fragResource = vegetationOre(look.w) ? int(vegetationResource(look.z)) : 0;
    gl_Position = jittered(camera.proj * camera.view * vec4(relativePos, 1.0));
}
