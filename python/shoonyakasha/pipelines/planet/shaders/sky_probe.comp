#version 450
//
// The sky probe's light (sky_probe.glsl), one texel per direction of its
// octahedral map, at the camera (camera.cameraFromCentre): the light the
// air scatters towards the camera along the direction (atmosphere.glsl's
// atmosphereAlong) and, where the direction meets the ground, the ground's
// light seen through the air (groundLightAt over pi: GROUND_BOUNCE of the
// light on level ground there, diffusely). Below the cloud layer's top
// (fading out through it), directions above the horizon take the clouds'
// coverage of their light from an overcast sky instead: CLOUD_LIGHT of the
// sunlight on level ground over pi, white, as sky_irradiance_lut.comp's.
// The sun's disk is left out: surfaces take the sun itself.
//

layout(local_size_x = 8, local_size_y = 8) in;

// The camera's, the atmosphere's and the clouds' uniforms and the tables,
// at cameraSet's bindings (camera.glsl), the first fields of each block alone.
layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    vec4 sunDirection;
    mat4 invView;
    mat4 invProj;
    vec4 cameraFromCentre;
} camera;

layout(set = 0, binding = 2) uniform AtmosphereParams {
    vec4 radii;
    vec4 rayleigh;
    vec4 mie;
    vec4 sun;
    vec4 ozone;
    vec4 settings;
} atmosphere;

layout(set = 0, binding = 3) uniform sampler2D transmittanceLut;
layout(set = 0, binding = 4) uniform sampler2D multiScatteringLut;
layout(set = 0, binding = 7) uniform CloudParams {
    vec4 layer;
    vec4 shape;
} clouds;
layout(set = 0, binding = 9) uniform sampler2D skyIrradianceLut;
#define ATMOSPHERE_TRANSMITTANCE_LUT
#define ATMOSPHERE_MULTI_SCATTERING_LUT
#define ATMOSPHERE_SKY_IRRADIANCE_LUT
#include "atmosphere.glsl"
#include "sky_probe.glsl"

layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D skyRadianceImage;

const float CLOUD_LIGHT = 0.4;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(SKY_PROBE_SIZE)))) return;
    vec3 d = skyOctDecode((vec2(texel) + 0.5) / float(SKY_PROBE_SIZE));
    vec3 ro = camera.cameraFromCentre.xyz;
    vec2 ground = raySphere(ro, d, atmosphere.radii.x);
    bool hitsGround = ground.y > 0.0 && ground.x > 0.0;
    vec3 inscatter, transmittance;
    atmosphereAlong(ro, d, hitsGround ? ground.x : 1e30, inscatter, transmittance);
    vec3 light = inscatter;
    if (hitsGround) {
        vec3 x = ro + d * ground.x;
        light += transmittance * groundLightAt(x, normalize(x)) / ATMOSPHERE_PI;
    } else {
        vec3 up = normalize(ro);
        float h = length(ro) - atmosphere.radii.x;
        float cover = clouds.shape.w * clouds.layer.z * (1.0 - smoothstep(clouds.layer.x, clouds.layer.y, h));
        vec3 overcast = CLOUD_LIGHT * sunlightAt(ro) * max(dot(up, atmosphere.sun.xyz), 0.0) / ATMOSPHERE_PI;
        light = mix(light, overcast, cover * smoothstep(-0.02, 0.05, dot(d, up)));
    }
    imageStore(skyRadianceImage, texel, vec4(light, 1.0));
}
