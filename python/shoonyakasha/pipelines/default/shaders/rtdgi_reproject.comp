#version 460
// Where each pixel's surface was on screen last frame (pass RtdgiReproject):
// its uv from the G-buffer's motion vectors, and whether last frame saw it
// there (on screen, and last frame's depth at that place within 5% of the
// depth the surface had for last frame's camera). reproj: xy last frame's
// uv minus this one's, z 1 when valid, w that depth.

#include "rtdgi_common.glsl"

layout(set = 3, binding = 0, rgba32f) uniform readonly image2D giPosition;
layout(set = 3, binding = 1, r32f) uniform readonly image2D prevDepth;
layout(set = 3, binding = 2) uniform sampler2D gVelocity;   // this frame's uv minus last frame's
layout(set = 3, binding = 3, rgba32f) uniform writeonly image2D reproj;

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    if (settings.gi != 2u) return;
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);
    if (any(greaterThanEqual(px, size))) return;

    vec4 position = imageLoad(giPosition, px);
    vec2 uv = pixelUv(px);
    if (position.w == 0.0) {
        // The sky: last frame's direction to it.
        vec4 clip = camera.prevViewProj * vec4(position.xyz - camera.position.xyz, 0.0);
        imageStore(reproj, px, vec4(clip.xy / clip.w * 0.5 + 0.5 - uv, 0.0, 0.0));
        return;
    }

    vec2 prevUv = uv - texelFetch(gVelocity, px, 0).xy;
    float expected = (camera.prevViewProj * vec4(position.xyz, 1.0)).w;
    bool valid = all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0))) && expected > 0.0;
    if (valid) {
        float depth = imageLoad(prevDepth, ivec2(prevUv * camera.resolution)).r;
        valid = depth > 0.0 && depthRelativeDiff(expected, depth) < 0.05;
    }
    imageStore(reproj, px, vec4(prevUv - uv, valid ? 1.0 : 0.0, expected));
}
