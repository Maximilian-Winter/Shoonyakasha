#version 450
// Light clusters: the view is divided into 16 x 9 screen tiles and 24 depth
// slices, spaced logarithmically from the camera's near plane to its far
// plane, and each cluster lists the point and spot lights whose range
// reaches it. Lighting then loops over its pixel's cluster only.
//
// The second step, after light_cluster_count.comp: each cluster's list, in
// the room it is given; see light_cluster_lists.glsl.

#include "light_cluster_lists.glsl"

void main() {
    uint cluster = gl_GlobalInvocationID.x;
    if (cluster > uint(CLUSTER_COUNT)) return;
    bool directionalColumn = cluster == uint(CLUSTER_COUNT);
    vec3 lo = vec3(0.0), hi = vec3(0.0);
    if (!directionalColumn) clusterBox(cluster, lo, hi);

    // All the lights it wants, or its share of the buffer.
    uint wanted = imageLoad(clusters, ivec2(cluster, 0)).r;
    uint capacity = uint(clusterLightIndices.length());
    uint room = wanted;
    if (counts.wanted > capacity) {
        room = uint(floor(float(wanted) * (float(capacity) / float(counts.wanted))));
    }
    uint offset = atomicAdd(counts.used, room);
    room = offset >= capacity ? 0u : min(room, capacity - offset);

    // Too little room: the largest distance that keeps the count within it.
    uint count = SCENE_LIGHT_COUNT;
    float cutoff = 1e30;
    if (room < wanted) {
        float farthest = 0.0;
        for (uint i = 0u; i < count; ++i) {
            float distance;
            if (belongs(i, directionalColumn, lo, hi, distance)) farthest = max(farthest, distance);
        }
        float below = 0.0, above = farthest;
        cutoff = 0.0;   // ties at 0 beyond the room: the first ones in light order
        for (int step = 0; step < 24; ++step) {
            float middle = 0.5 * (below + above);
            uint within = 0u;
            for (uint i = 0u; i < count; ++i) {
                float distance;
                if (belongs(i, directionalColumn, lo, hi, distance) && distance <= middle) ++within;
            }
            if (within <= room) {
                cutoff = middle;
                below = middle;
            } else {
                above = middle;
            }
        }
    }

    uint written = 0u;
    for (uint i = 0u; i < count && written < room; ++i) {
        float distance;
        if (belongs(i, directionalColumn, lo, hi, distance) && distance <= cutoff) {
            clusterLightIndices[offset + written] = i;
            ++written;
        }
    }
    imageStore(clusters, ivec2(cluster, 0), uvec4(written));
    imageStore(clusters, ivec2(cluster, 1), uvec4(offset));
}
