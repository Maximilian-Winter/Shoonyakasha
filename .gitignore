# Any CLion / CMake build directory, not just the two that happened to exist.
cmake-build-*/
/build/
/.idea
*.log
run.out

# Frame-capture output from examples and the instancing self-test
*.mkv
selftest_screenshot.png
# ── Large example assets ──────────────────────────────────────────────
#
# One shared copy of everything the examples load lives in assets/, small enough
# to commit (see assets/README.md). These patterns cover what stays out: the
# per-example asset directories that predate that consolidation, third-party
# scenes too large or too licence-encumbered to redistribute, and output written
# at runtime.
#
# Patterns rather than one line per example directory -- the old list named
# specific examples and had to be extended by hand every time one was added,
# which is how two 99 MB environment maps ended up committed.

cubemaps_hdrs/
screenshots/
NewSponza_*
/pkg_a_curtains
/glTF-Sample-Assets/
/old_not_working_examples
/examples/*/textures/
/examples/*/data/
/examples/sponza_test/glTF/
/examples/sponza_test/glTF_sponza_old
/python/examples/textures/

# Fetched into the shared asset root by tools/fetch_assets.py. The committed 1k
# versions are deliberately NOT matched.
/assets/env/*_4k.hdr
/assets/env/*_8k.hdr
/assets/models/NewSponza_*
/.claude

# Compiled Cython/Python extension + generated intermediates (built by
# python/CMakeLists.txt or `pip install`, never checked in)
/python/shoonyakasha/_shoonyakasha*.so
/python/shoonyakasha/_shoonyakasha*.pyd
/python/shoonyakasha/_shoonyakasha.cpp
__pycache__/
*.pyc

# pip/scikit-build-core build output
/build/
*.egg-info/
/.venv
/python/shoonyakasha/vulkan-1.dll
/python/shoonyakasha/glfw3.dll
/examples/facade_test/cubemaps_hdrs
/examples/pong_game/assets
PowerShell-Commands.txt
