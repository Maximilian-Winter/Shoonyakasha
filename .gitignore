# Any CLion / CMake build directory, not just the two that happened to exist.
cmake-build-*/
/build/
/.idea
*.log
shoonyakasha_pipeline_cache.bin*
# IBL caches written beside HDR maps (IBL/IBLCache.h); baked .ibl files are kept.
*.hdr.ibl
*.ibl.partial
run.out

# Frame-capture output from examples and the instancing self-test
*.mkv
selftest_screenshot.png
# ── Large example assets ──────────────────────────────────────────────
#
# One shared copy of everything the examples load lives in assets/, small enough
# to commit (see assets/README.md). These patterns cover what stays out: the
# per-example asset directories that predate that consolidation, third-party
# scenes too large or too licence-encumbered to redistribute, and output written
# at runtime.
#
# Patterns rather than one line per example directory -- the old list named
# specific examples and had to be extended by hand every time one was added,
# which is how two 99 MB environment maps ended up committed.

cubemaps_hdrs/
screenshots/
NewSponza_*
/pkg_a_curtains
/glTF-Sample-Assets/
/old_not_working_examples
# Depth-independent, so these keep working wherever an example is filed.
# (They were /examples/*/... when every example sat one level down.)
examples/**/textures/
examples/**/data/
examples/**/cubemaps_hdrs/

# Left behind by the move to examples/python/. Nothing here is tracked any
# more; the directory holds local downloads and logs and can be deleted.
/python/examples/

# Fetched into the shared asset root by tools/fetch_assets.py. The committed 1k
# versions are deliberately NOT matched.
/assets/env/*_4k.hdr
/assets/env/*_8k.hdr
/assets/models/NewSponza_*
/assets/polyhaven/
/assets/bistro/
/assets/showroom/
# Generated on first start by examples/python/rendering/stage/stage_set.py.
/assets/stage/
/assets/kajiya/
# Downloaded by hand from Sketchfab; see assets/README.md.
/assets/models/japanese_shrine.glb
/.claude

# Compiled Cython/Python extension + generated intermediates (built by
# python/CMakeLists.txt or `pip install`, never checked in)
/python/shoonyakasha/_shoonyakasha*.so
/python/shoonyakasha/_shoonyakasha*.pyd
/python/shoonyakasha/_shoonyakasha.cpp
__pycache__/
*.pyc

# pip/scikit-build-core build output
/build/
*.egg-info/
/.venv
/.venv-docs/
/site/
/python/shoonyakasha/vulkan-1.dll
/python/shoonyakasha/glfw3.dll
/python/shoonyakasha/harfbuzz.dll
/python/shoonyakasha/freetype.dll
/python/shoonyakasha/SheenBidi.dll
/python/shoonyakasha/draco.dll
/python/shoonyakasha/ktx.dll
/python/shoonyakasha/zstd.dll
/examples/python/games_2d/pong_game/assets

# The Python examples compile their shaders at startup, so the .spv under them
# are build output rather than something to ship and let drift out of date.
# The C++ examples still commit theirs; CMake builds those.
examples/python/**/*.spv
# Test fixtures, compiled by tests/CMakeLists.txt.
/tests/shaders/*.spv
# glslc dependency files, written beside every compiled shader.
*.spv.d

# Output the Python examples write where they run.
examples/python/**/*.log
examples/python/**/*.mkv
examples/python/**/*_screenshot.png
PowerShell-Commands.txt
/examples/python/games_2d/dakini_temple/fonts
# Devanagari labels temple.py renders on first run.
/examples/python/games_2d/dakini_temple/generated/
/examples/python/ui/ui_showcase/generated/
examples/python/rendering/museum/museum.mp4
/examples/python/rendering/museum/museum_captures
examples/python/rendering/showroom/tour.mp4
examples/python/rendering/showroom/reel.mp4
/examples/python/rendering/showroom/showroom_captures
/examples/python/rendering/stage/stage_captures
/old_dx12_engine_code/
/cool-gfx-repos/
/examples/python/rendering/irradiance_cache/irradiance_cache_captures
/examples/python/rendering/volume_tiled/volume_tiled_captures
/examples/python/rendering/split_screen/split_screen_captures
/examples/python/rendering/wave_optics/wave_optics_captures
/examples/python/rendering/rt_reflections/rt_reflections_captures
/examples/python/rendering/optics/brewster_captures
/examples/python/rendering/optics/gold_captures
