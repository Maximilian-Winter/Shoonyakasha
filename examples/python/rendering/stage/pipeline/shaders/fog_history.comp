#version 450
// This frame's fog grid kept for the next (pass FogHistory): fogScatter
// copied into fogHistory, which persists from frame to frame.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray fogScatter;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray fogHistory;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, imageSize(fogHistory)))) return;
    imageStore(fogHistory, id, texelFetch(fogScatter, id, 0));
}
