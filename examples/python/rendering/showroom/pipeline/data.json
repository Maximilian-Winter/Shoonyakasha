  "entityDataBindings": {
    "shadowOpaque": {
      "perDraw": {
        "layoutRef": "ShadowDraw"
      }
    },
    "shadowMasked": {
      "perDraw": {
        "layoutRef": "MaskedShadowDraw"
      },
      "material": {
        "layoutRef": "materialSet"
      }
    },
    "shadowSkinned": {
      "perDraw": {
        "layoutRef": "ShadowDraw"
      },
      "skeleton": {
        "layoutRef": "skeletonSet"
      }
    },
    "material": {
      "perDraw": {
        "layoutRef": "MaterialDraw"
      },
      "material": {
        "layoutRef": "materialSet"
      }
    },
    "skinnedMaterial": {
      "perDraw": {
        "layoutRef": "MaterialDraw"
      },
      "material": {
        "layoutRef": "materialSet"
      },
      "skeleton": {
        "layoutRef": "skeletonSet"
      }
    },
    "overlay": {
      "perDraw": {
        "layoutRef": "OverlayDraw"
      },
      "material": {
        "layoutRef": "overlayTextureSet"
      }
    }
  },
  "samplers": {
    "nearestClamp": {
      "magFilter": "nearest",
      "minFilter": "nearest",
      "mipmapMode": "nearest",
      "addressMode": "clamp_to_edge"
    },
    "linearClamp": {
      "magFilter": "linear",
      "minFilter": "linear",
      "addressMode": "clamp_to_edge"
    },
    "shadowCompare": {
      "magFilter": "linear",
      "minFilter": "linear",
      "addressMode": "clamp_to_edge",
      "compareEnable": true,
      "compareOp": "less_or_equal"
    },
    "trilinearClamp": {
      "magFilter": "linear",
      "minFilter": "linear",
      "mipmapMode": "linear",
      "addressMode": "clamp_to_edge",
      "maxLod": 16.0
    }
  }
}
