{
  "vertexFormats": {
    "skinned": {
      "attributes": [
        {
          "name": "position",
          "type": "vec3",
          "location": 0
        },
        {
          "name": "normal",
          "type": "vec3",
          "location": 1
        },
        {
          "name": "texCoord",
          "type": "vec2",
          "location": 2
        },
        {
          "name": "jointIndices",
          "type": "uvec4",
          "location": 3
        },
        {
          "name": "jointWeights",
          "type": "vec4",
          "location": 4
        },
        {
          "name": "tangent",
          "type": "vec4",
          "location": 5
        }
      ]
    },
    "sprite2d": {
      "attributes": [
