        {
          "name": "proj",
          "type": "mat4",
          "source": "scene.camera.projection"
        },
        {
          "name": "invView",
          "type": "mat4",
          "source": "scene.camera.invView"
        },
        {
          "name": "invProj",
          "type": "mat4",
          "source": "scene.camera.invProj"
        },
        {
          "name": "position",
          "type": "vec4",
          "source": "scene.camera.positionVec4"
        },
        {
          "name": "params",
          "type": "vec4",
          "source": "scene.camera.nearFarFovAspect"
        },
        {
          "name": "prevViewProj",
          "type": "mat4",
          "source": "scene.camera.prevViewProjection"
