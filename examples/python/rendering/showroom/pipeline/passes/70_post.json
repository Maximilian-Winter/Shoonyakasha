{
  "descriptorSetLayouts": {
    "tonemapSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "hdrColor",
          "autoBindResource": "sceneColor",
          "autoBindSampler": "linearClamp"
        },
        {
          "binding": 1,
          "type": "uniform_buffer",
          "stages": [
            "fragment"
          ],
          "name": "Settings",
          "autoBindBuffer": "Settings"
        },
        {
          "binding": 2,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "bloom",
          "autoBindResource": "bloomChain",
          "autoBindSampler": "linearClamp",
          "mip": 0
        },
        {
          "binding": 3,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "exposureImage",
          "autoBindResource": "exposure",
          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 4,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "accumulated",
          "autoBindResource": "accumColor",
          "autoBindSampler": "nearestClamp"
        }
      ]
    },
    "accumulateSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "storage_image",
          "stages": [
            "compute"
          ],
          "name": "accum",
          "autoBindResource": "accumColor"
        },
        {
          "binding": 1,
          "type": "combined_image_sampler",
          "stages": [
            "compute"
          ],
          "name": "sceneColor",
          "autoBindResource": "sceneColor",
          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 2,
          "type": "uniform_buffer",
          "stages": [
            "compute"
          ],
          "name": "Settings",
          "autoBindBuffer": "Settings"
        }
      ]
    },
    "dofSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "rawColor",
          "autoBindResource": "hdrColor",
          "autoBindSampler": "linearClamp"
        },
        {
          "binding": 1,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "taaColor",
          "autoBindResource": "taaColor",
          "autoBindSampler": "linearClamp"
        },
        {
          "binding": 2,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "gDepth",
          "autoBindResource": "gDepth",
          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 3,
          "type": "uniform_buffer",
          "stages": [
            "fragment"
          ],
          "name": "Settings",
          "autoBindBuffer": "Settings"
        }
      ]
    },
    "bloomDownFirstSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "source",
          "autoBindResource": "taaColor",
          "autoBindSampler": "linearClamp"
        }
      ]
    },
    "bloomDown{m}": {
      "repeat": {
        "count": 5,
        "index": "m",
        "first": 1
      },
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "source",
          "autoBindResource": "bloomChain",
          "autoBindSampler": "linearClamp",
          "mip": "{m-1}"
        }
      ]
    },
    "bloomUp{m}": {
      "repeat": {
        "count": 5,
        "index": "m",
        "first": 4,
        "step": -1
      },
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "source",
          "autoBindResource": "bloomChain",
          "autoBindSampler": "linearClamp",
          "mip": "{m+1}"
        }
      ]
    },
    "exposureSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "compute"
          ],
          "name": "luminanceSource",
          "autoBindResource": "bloomChain",
          "autoBindSampler": "nearestClamp",
          "mip": 2
        },
        {
          "binding": 1,
          "type": "storage_image",
          "stages": [
            "compute"
          ],
          "name": "exposureImage",
          "autoBindResource": "exposure"
        }
      ]
    },
    "taaSet": {
      "bindings": [
        {
          "binding": 0,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "current",
          "autoBindResource": "hdrColor",
          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 1,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "gDepth",
          "autoBindResource": "gDepth",
          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 2,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "history",
          "autoBindResource": "taaHistory",
          "autoBindSampler": "linearClamp"
        },
        {
          "binding": 3,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "gVelocity",
          "autoBindResource": "gVelocity",
          "autoBindSampler": "nearestClamp"
        }
      ]
    }
  },
  "passes": [
    {
      "name": "TAA",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "hdrColor",
          "usage": "shader_read"
        },
        {
          "resource": "gDepth",
          "usage": "shader_read"
        },
        {
          "resource": "gVelocity",
          "usage": "shader_read"
        },
        {
          "resource": "taaHistory",
          "usage": "shader_read"
        }
      ],
      "outputs": [
        {
          "resource": "taaColor",
          "usage": "color_write",
          "clear": [
            0.0,
            0.0,
            0.0,
            0.0
          ]
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none",
        "fragmentShader": "../shaders/taa.frag.spv"
      },
      "descriptorSets": [
        "taaSet",
        "cameraSet"
      ]
    },
    {
      "name": "DepthOfField",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "hdrColor",
          "usage": "shader_read"
        },
        {
          "resource": "taaColor",
          "usage": "shader_read"
        },
        {
          "resource": "gDepth",
          "usage": "shader_read"
        }
      ],
      "outputs": [
        {
          "resource": "sceneColor",
          "usage": "color_write",
          "clear": [
            0.0,
            0.0,
            0.0,
            0.0
          ]
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none",
        "fragmentShader": "../shaders/depth_of_field.frag.spv"
      },
      "descriptorSets": [
        "dofSet",
        "cameraSet"
      ]
    },
    {
      "name": "Accumulate",
      "type": "compute",
      "enabled": false,
      "execution": {
        "type": "compute_image",
        "workgroupSize": [
          8,
          8,
          1
        ]
      },
      "inputs": [
        {
          "resource": "sceneColor",
          "usage": "shader_read"
        }
      ],
      "outputs": [
        {
          "resource": "accumColor",
          "usage": "shader_read_write"
        }
      ],
      "pipeline": {
        "computeShader": "../shaders/accumulate.comp.spv"
      },
      "descriptorSets": [
        "accumulateSet"
      ]
    },
    {
      "name": "TAAHistory",
      "type": "transfer",
      "execution": {
        "type": "copy"
      },
      "inputs": [
        {
          "resource": "taaColor",
          "usage": "transfer_src"
        }
      ],
      "outputs": [
        {
          "resource": "taaHistory",
          "usage": "transfer_dst"
        }
      ]
    },
    {
      "name": "BloomDown0",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "taaColor",
          "usage": "shader_read"
        }
      ],
      "outputs": [
        {
          "resource": "bloomChain",
          "usage": "color_write",
          "mip": 0,
          "clear": [
            0,
            0,
            0,
            1
          ]
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "fragmentShader": "../shaders/bloom_down_first.frag.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none"
      },
      "descriptorSets": [
        "bloomDownFirstSet"
      ]
    },
    {
      "name": "BloomDown{m}",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "bloomChain",
          "usage": "shader_read",
          "mip": "{m-1}"
        }
      ],
      "outputs": [
        {
          "resource": "bloomChain",
          "usage": "color_write",
          "mip": "{m}",
          "clear": [
            0,
            0,
            0,
            1
          ]
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "fragmentShader": "../shaders/bloom_down.frag.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none"
      },
      "descriptorSets": [
        "bloomDown{m}"
      ],
      "repeat": {
        "count": 5,
        "index": "m",
        "first": 1
      }
    },
    {
      "name": "AutoExposure",
      "type": "compute",
      "execution": {
        "type": "compute_dispatch",
        "workgroupSize": [
          16,
          16,
          1
        ],
        "dispatch": {
          "x": 1,
          "y": 1,
          "z": 1
        }
      },
      "inputs": [
        {
          "resource": "bloomChain",
          "usage": "shader_read",
          "mip": 2
        }
      ],
      "outputs": [
        {
          "resource": "exposure",
          "usage": "shader_read_write"
        }
      ],
      "pipeline": {
        "computeShader": "../shaders/exposure.comp.spv"
      },
      "descriptorSets": [
        "exposureSet",
        "settingsSet"
      ]
    },
    {
      "name": "BloomUp{m}",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "bloomChain",
          "usage": "shader_read",
          "mip": "{m+1}"
        }
      ],
      "outputs": [
        {
          "resource": "bloomChain",
          "usage": "color_blend",
          "mip": "{m}"
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "fragmentShader": "../shaders/bloom_up.frag.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none",
        "blending": "additive"
      },
      "descriptorSets": [
        "bloomUp{m}",
        "settingsSet"
      ],
      "repeat": {
        "count": 5,
        "index": "m",
        "first": 4,
        "step": -1
      }
    },
    {
      "name": "Tonemap",
      "type": "graphics",
      "execution": {
        "type": "fullscreen"
      },
      "inputs": [
        {
          "resource": "sceneColor",
          "usage": "shader_read"
        },
        {
          "resource": "bloomChain",
          "usage": "shader_read",
          "mip": 0
        },
        {
          "resource": "exposure",
          "usage": "shader_read"
        },
        {
          "resource": "accumColor",
          "usage": "shader_read"
        }
      ],
      "outputs": [
        {
          "resource": "swapchain",
          "usage": "color_write",
          "present": true,
          "clear": [
            0.0,
            0.0,
            0.0,
            1.0
          ]
        }
      ],
      "pipeline": {
        "vertexShader": "../shaders/fullscreen.vert.spv",
        "fragmentShader": "../shaders/tonemap.frag.spv",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "vertexInput": "none"
      },
      "descriptorSets": [
        "tonemapSet"
      ]
    }
  ]
}
