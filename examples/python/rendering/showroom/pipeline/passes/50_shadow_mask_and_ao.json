          "autoBindSampler": "nearestClamp"
        },
        {
          "binding": 1,
          "type": "combined_image_sampler",
          "stages": [
            "fragment"
          ],
          "name": "gDepth",
          "autoBindResource": "gDepth",
          "autoBindSampler": "nearestClamp"
        }
      ]
    }
