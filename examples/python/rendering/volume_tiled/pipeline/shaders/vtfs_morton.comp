#version 450
// VTFS: each light's 30-bit Morton code (van Oosten, Algorithm 6.3), its
// view position quantised to 10 bits per axis in the box around all lights,
// paired with its index for the sort.

#include "vtfs_compute.glsl"

layout(local_size_x = 256) in;

VTFS_LIGHTS_VIEW(readonly)
VTFS_LIGHT_BOUNDS(readonly)
VTFS_KEYS_A(writeonly)
VTFS_VALUES_A(writeonly)

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= lightCount()) return;
    AABB bounds = lightBounds[VTFS_REDUCE_GROUPS];
    vec3 extent = max(bounds.hi.xyz - bounds.lo.xyz, vec3(1e-6));
    keysA[i] = mortonCode((lightsView[i].xyz - bounds.lo.xyz) / extent);
    valuesA[i] = i;
}
