#version 460
// This frame's half resolution reflection reservoirs and samples become
// next frame's history.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D rtrRadianceOut;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D rtrRayOrigOut;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D rtrRayOut;
layout(set = 0, binding = 3, r32ui) uniform readonly uimage2D rtrRngOut;
layout(set = 0, binding = 4, rg32ui) uniform readonly uimage2D rtrReservoirOut;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D rtrHitNormalOut;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D rtrRadianceHistory;
layout(set = 0, binding = 7, rgba32f) uniform writeonly image2D rtrRayOrigHistory;
layout(set = 0, binding = 8, rgba32f) uniform writeonly image2D rtrRayHistory;
layout(set = 0, binding = 9, r32ui) uniform writeonly uimage2D rtrRngHistory;
layout(set = 0, binding = 10, rg32ui) uniform writeonly uimage2D rtrReservoirHistory;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D rtrHitNormalHistory;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, imageSize(rtrRadianceOut)))) return;
    imageStore(rtrRadianceHistory, px, imageLoad(rtrRadianceOut, px));
    imageStore(rtrRayOrigHistory, px, imageLoad(rtrRayOrigOut, px));
    imageStore(rtrRayHistory, px, imageLoad(rtrRayOut, px));
    imageStore(rtrRngHistory, px, imageLoad(rtrRngOut, px));
    imageStore(rtrReservoirHistory, px, imageLoad(rtrReservoirOut, px));
    imageStore(rtrHitNormalHistory, px, imageLoad(rtrHitNormalOut, px));
}
