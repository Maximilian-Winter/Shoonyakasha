#version 460
// Temporal filter of the reflections, with two histories: one reprojected
// with the surface, and one with the reflected image (the point the ray
// length puts behind the surface, seen through it). Rough surfaces lean on
// the first, smooth ones on whichever lies closer to the neighbourhood's
// mean, and moving the eye trusts the first less on smooth surfaces. Both
// are softly clamped towards the 3 x 3 neighbourhood (tighter where
// validation found changes), then blended over up to 16 frames.
// rtrTemporalOut: rgb, the frames in it.

#include "common.glsl"
#define IRCACHE_SET 0
#include "ircache.glsl"
#include "specular.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0, rgba16f) uniform readonly image2D rtrResolved;
layout(set = 2, binding = 1, rgba16f) uniform readonly image2D rtrHistory;
layout(set = 2, binding = 2, rgba32f) uniform readonly image2D gPosition;
layout(set = 2, binding = 3, rg16f) uniform readonly image2D rtrRayLenOut;
layout(set = 2, binding = 4, rgba32f) uniform readonly image2D reproj;
layout(set = 2, binding = 5, r32f) uniform readonly image2D prevDepth;
layout(set = 2, binding = 6, r16f) uniform readonly image2D rtrInvalidity;
layout(set = 2, binding = 7, rgba16f) uniform readonly image2D gGeoNormal;
layout(set = 2, binding = 8, rgba16f) uniform writeonly image2D rtrTemporalOut;

vec3 softColorClamp(vec3 center, vec3 history, vec3 ex, vec3 dev) {
    vec3 historyDist = abs(history - ex) / max(abs(history * 0.1), dev);
    vec3 closest = clamp(history, center - dev, center + dev);
    return mix(history, closest, smoothstep(1.0, 3.0, historyDist));
}

// A bilinear fetch of the history at uv, over the texels whose depth
// matches `expectedDepth`; `validTaps` counts them.
vec4 historyAt(vec2 uv, float expectedDepth, ivec2 size, out int validTaps) {
    vec2 texel = uv * camera.resolution - 0.5;
    ivec2 o = ivec2(floor(texel));
    vec2 f = texel - vec2(o);
    vec4 sum = vec4(0.0), all4 = vec4(0.0);
    float wSum = 0.0;
    validTaps = 0;
    for (int i = 0; i < 4; ++i) {
        ivec2 tap = clamp(o + ivec2(i & 1, i >> 1), ivec2(0), size - 1);
        float w = ((i & 1) != 0 ? f.x : 1.0 - f.x) * ((i >> 1) != 0 ? f.y : 1.0 - f.y);
        vec4 h = imageLoad(rtrHistory, tap);
        all4 += h * w;
        float depth = imageLoad(prevDepth, tap).r;
        if (expectedDepth <= 0.0 || (depth > 0.0 && depthRelativeDiff(expectedDepth, depth) < 0.05)) {
            sum += h * w;
            wSum += w;
            validTaps++;
        }
    }
    return wSum > 1e-5 ? sum / wSum : all4;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);
    if (any(greaterThanEqual(px, size))) return;

    vec4 center = imageLoad(rtrResolved, px);
    vec4 position = imageLoad(gPosition, px);
    if ((settings.stages & STAGE_RTR_FILTERS) == 0u || position.w == 0.0) {
        imageStore(rtrTemporalOut, px, vec4(center.rgb, 1.0));
        return;
    }
    float alpha = specularAlpha(imageLoad(gGeoNormal, px).w);
    vec2 uv = pixelUv(px);
    vec4 r = imageLoad(reproj, px);

    int taps0;
    vec4 history0 = historyAt(uv + r.xy, r.w, size, taps0);
    float history0Valid = r.z != 0.0 && taps0 > 0 ? 1.0 : 0.0;

    // The reflected image's place last frame.
    float rayLength = clamp(imageLoad(rtrRayLenOut, px).x, 0.0, 1e3);
    vec3 viewDir = normalize(position.xyz - camera.position.xyz);
    vec4 hitClip = camera.prevViewProj * vec4(position.xyz + viewDir * rayLength, 1.0);
    vec2 hitPrevUv = hitClip.w > 0.0 ? hitClip.xy / hitClip.w * 0.5 + 0.5 : uv + r.xy;
    int taps1;
    vec4 history1 = historyAt(hitPrevUv, 0.0, size, taps1);
    float history1Valid = r.z != 0.0 && taps0 == 4 ? 1.0 : 0.0;

    vec3 vsum = vec3(0.0), vsum2 = vec3(0.0);
    float wsum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 tap = clamp(px + ivec2(x, y), ivec2(0), size - 1);
            float depth = imageLoad(gPosition, tap).w;
            vec3 n = imageLoad(rtrResolved, tap).rgb;
            float w = depth > 0.0 ? exp2(-200.0 * abs(position.w / depth - 1.0)) : 0.0;
            vsum += n * w;
            vsum2 += n * n * w;
            wsum += w;
        }
    }
    vec3 ex = vsum / max(wsum, 1e-8);
    vec3 dev = sqrt(max(vec3(0.0), vsum2 / max(wsum, 1e-8) - ex * ex));

    float invalidity = imageLoad(rtrInvalidity, min(px / 2, imageSize(rtrInvalidity) - 1)).r;
    float deviations = mix(r.z > 0.0 ? 2.0 : 1.25, 0.625, invalidity);
    vec3 currentWo = viewDir;
    vec3 previousWo = normalize(position.xyz - previousEyePosition());
    float clampedAlpha = max(0.1, alpha);
    float woSimilarity = pow(clamp(ggxNdf01(clampedAlpha * clampedAlpha, dot(currentWo, previousWo)), 0.0, 1.0), 32.0);

    float h0diff = length((history0.rgb - ex) / max(dev, vec3(1e-6)));
    float h1diff = length((history1.rgb - ex) / max(dev, vec3(1e-6)));
    float h0score = smoothstep(0.0, 0.5, sqrt(alpha)) * mix(woSimilarity, 1.0, sqrt(alpha));
    float h1score = (1.0 - h0score) * mix(1.0, smoothstep(0.0, 1.0, h0diff - h1diff), smoothstep(0.0, 0.15, sqrt(alpha)));
    h0score *= history0Valid;
    h1score *= history1Valid;
    float scoreSum = h0score + h1score;
    h0score = scoreSum > 0.0 ? h0score / scoreSum : 1.0;
    h1score = 1.0 - h0score;

    vec4 clamped0 = vec4(softColorClamp(center.rgb, history0.rgb, ex, dev * deviations), history0.a);
    vec4 clamped1 = vec4(softColorClamp(center.rgb, history1.rgb, ex, dev * deviations), history1.a);
    vec4 clampedHistory = clamped0 * h0score + clamped1 * h1score;

    const float MAX_SAMPLES = 16.0;
    float sampleCount = clampedHistory.a * clamp(h0score * history0Valid + h1score * history1Valid, 0.0, 1.0);
    vec3 result = mix(clampedHistory.rgb, center.rgb,
                      1.0 / (1.0 + min(MAX_SAMPLES, sampleCount * mix(woSimilarity, 1.0, 0.5))));
    imageStore(rtrTemporalOut, px, vec4(max(result, vec3(0.0)), min(sampleCount, MAX_SAMPLES) + 1.0));
}
