#version 460
// Temporal filter of the resolved indirect light. The reprojected history
// is clamped to a box around the 5 x 5 neighbourhood's mean (its size the
// local deviation, narrower where validation found changes), then blended
// with the new value as a running mean of up to 32 frames. Fewer frames
// count where the light changes beyond its usual variance, tracked as
// luminance moments over time. giHistoryOut: rgb, the frames in it.
// temporalOut: rgb, and how settled it is (0 to 1), for the spatial filter.

#include "common.glsl"
#define IRCACHE_SET 0
#include "ircache.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0, rgba16f) uniform readonly image2D resolved;
layout(set = 2, binding = 1, rgba16f) uniform readonly image2D reprojectedGi;
layout(set = 2, binding = 2, rg16f) uniform readonly image2D varianceHistory;
layout(set = 2, binding = 3, rgba32f) uniform readonly image2D reproj;
layout(set = 2, binding = 4, rg16f) uniform readonly image2D invalidity;
layout(set = 2, binding = 5, rgba16f) uniform writeonly image2D temporalOut;
layout(set = 2, binding = 6, rgba16f) uniform writeonly image2D giHistoryOut;
layout(set = 2, binding = 7, rg16f) uniform writeonly image2D varianceOut;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);
    if (any(greaterThanEqual(px, size))) return;

    vec4 centerValue = imageLoad(resolved, px);
    vec4 r = imageLoad(reproj, px);
    vec4 history = imageLoad(reprojectedGi, px);
    if ((settings.stages & STAGE_TEMPORAL_FILTER) == 0u) {
        imageStore(temporalOut, px, vec4(centerValue.rgb, 1.0));
        imageStore(giHistoryOut, px, vec4(centerValue.rgb, 1.0));
        imageStore(varianceOut, px, vec4(0.0));
        return;
    }

    vec3 vsum = vec3(0.0), vsum2 = vec3(0.0);
    float wsum = 0.0, historyLumaSum = 0.0;
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 tap = clamp(px + ivec2(x, y), ivec2(0), size - 1);
            vec3 neighbor = imageLoad(resolved, tap).rgb;
            float historyLuma = luminance(imageLoad(reprojectedGi, tap).rgb);
            float w = exp(-3.0 * float(x * x + y * y) / 9.0);
            vsum += neighbor * w;
            vsum2 += neighbor * neighbor * w;
            historyLumaSum += historyLuma * w;
            wsum += w;
        }
    }
    vec3 ex = vsum / wsum;
    vec3 dev = sqrt(max(vec3(0.0), vsum2 / wsum - ex * ex));
    historyLumaSum /= wsum;

    ivec2 previousPx = clamp(ivec2((pixelUv(px) + r.xy) * camera.resolution), ivec2(0), size - 1);
    vec2 momentsHistory = r.z != 0.0 ? imageLoad(varianceHistory, previousPx).xy : vec2(0.0);
    float centerLuma = luminance(centerValue.rgb) + (historyLumaSum - luminance(ex));
    vec2 moments = vec2(centerLuma, centerLuma * centerLuma);
    imageStore(varianceOut, px, vec4(max(vec2(0.0), mix(momentsHistory, moments, 0.25)), 0.0, 0.0));
    float temporalDev = sqrt(max(0.0, momentsHistory.y - momentsHistory.x * momentsHistory.x));

    float temporalChange = abs(historyLumaSum - luminance(ex)) / max(1e-8, historyLumaSum + luminance(ex));
    float rtInvalid = clamp(sqrt(imageLoad(invalidity, px / 2).x) * 4.0, 0.0, 1.0);
    float sampleCount = history.a;

    float boxSize = max(0.5, mix(0.25, 2.0, 1.0 - rtInvalid) * mix(0.333, 1.0, clamp(r.z, 0.0, 1.0)) * 2.0);
    vec3 clamped = clamp(history.rgb, centerValue.rgb - dev * boxSize, centerValue.rgb + dev * boxSize);

    float change = smoothstep(0.1, 1.0, 0.05 * temporalChange / max(temporalDev, 1e-8));
    float maxSamples = mix(32.0, 4.0, change) * mix(1.0, 0.5, rtInvalid);
    vec3 result = mix(clamped, centerValue.rgb, 1.0 / (1.0 + min(maxSamples, sampleCount)));
    float outputCount = min(sampleCount, maxSamples) + 1.0;
    result = max(result, vec3(0.0));

    imageStore(giHistoryOut, px, vec4(result, outputCount));
    imageStore(temporalOut, px, vec4(result, clamp(outputCount * mix(1.0, 0.5, rtInvalid) *
                                                   smoothstep(0.3, 0.0, temporalChange) / 32.0, 0.0, 1.0)));
}
