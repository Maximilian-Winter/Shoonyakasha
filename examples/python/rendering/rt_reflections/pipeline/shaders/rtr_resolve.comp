#version 460
// Full resolution reflections from up to eight half resolution reservoirs,
// picked in a world-space kernel on the surface: an ellipse across the
// reflected lobe, sized by the lobe's width and the (averaged) distance to
// what is reflected. Each reused sample's radiance counts by a ratio
// estimator: the lobe's density towards its hit from here over the density
// it was drawn with (blended between the sample's own lobe, "bent" by its
// half-vector angle, and this pixel's), with a MIS weight against its ray's
// density. The sum is divided by the lobe's directional albedo, so the
// filters work on the reflected light alone; the image multiplies it back.
// Neighbours of unlike normals or depths, or that see the hit from below
// this surface, are left out. rtrRayLenOut: x the weighted ray length, y
// its running average.

#include "common.glsl"
#define IRCACHE_SET 0
#define SPEC_LUT_IMAGE
#include "ircache.glsl"
#include "sk/pbr.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0, rgba32f) uniform readonly image2D gPosition;
layout(set = 2, binding = 1, rgba16f) uniform readonly image2D gNormal;
layout(set = 2, binding = 2, rgba16f) uniform readonly image2D gGeoNormal;
layout(set = 2, binding = 3, rgba16f) uniform readonly image2D gAlbedo;
layout(set = 2, binding = 4, rgba32f) uniform readonly image2D reproj;
layout(set = 2, binding = 5, rgba32f) uniform readonly image2D rtrCandHit;
layout(set = 2, binding = 6, rg16f) uniform readonly image2D rtrRayLenHistory;
layout(set = 2, binding = 7, rgba16f) uniform readonly image2D rtrRadianceOut;
layout(set = 2, binding = 8, rgba32f) uniform readonly image2D rtrRayOut;
layout(set = 2, binding = 9, rg32ui) uniform readonly uimage2D rtrReservoirOut;
layout(set = 2, binding = 10, rgba32f) uniform readonly image2D rtrRayOrigOut;
layout(set = 2, binding = 11, rgba16f) uniform readonly image2D specLut;
layout(set = 2, binding = 12, rgba16f) uniform writeonly image2D rtrResolved;
layout(set = 2, binding = 13, rg16f) uniform writeonly image2D rtrRayLenOut;

#include "specular.glsl"

const uint MAX_SAMPLE_COUNT = 8u;
const float NEIGHBOR_ORIGIN_CENTER_BIAS = 0.5;
const float MAX_PDF_CLAMP = 200.0;
const float RADIUS_INC_ON_FAIL = 0.25;

float exponentialSquish(float len, float scale) { return exp2(-clamp(scale * len, 0.0, 100.0)); }
float exponentialUnsquish(float len, float scale) { return max(0.0, -1.0 / scale * log2(1e-30 + len)); }
vec3 toView(vec3 p) { return (camera.view * vec4(p, 1.0)).xyz; }

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullSize = ivec2(camera.resolution);
    if (any(greaterThanEqual(px, fullSize))) return;
    ivec2 halfSize = imageSize(rtrRadianceOut);
    ivec2 halfPx = min(px / 2, halfSize - 1);

    vec4 position = imageLoad(gPosition, px);
    if (position.w == 0.0) {
        imageStore(rtrResolved, px, vec4(0.0));
        imageStore(rtrRayLenOut, px, vec4(0.0));
        return;
    }
    vec4 normalMetal = imageLoad(gNormal, px);
    vec4 geoRough = imageLoad(gGeoNormal, px);
    vec3 N = normalMetal.xyz;
    float alpha = specularAlpha(geoRough.w);
    float a2 = alpha * alpha;
    vec3 F0 = baseReflectivity(imageLoad(gAlbedo, px).rgb, normalMetal.w);
    vec3 origin = secondaryRayOrigin(position.xyz, geoRough.xyz, position.w);
    vec3 originVs = toView(origin);

    vec3 t, b;
    {
        float s = N.z >= 0.0 ? 1.0 : -1.0;
        float aa = -1.0 / (s + N.z);
        float c = N.x * N.y * aa;
        t = vec3(1.0 + s * N.x * N.x * aa, s * c, -s * N.x);
        b = vec3(c, s + N.y * N.y * aa, -N.y);
    }
    vec3 viewDir = normalize(position.xyz - camera.position.xyz);
    vec3 wo = vec3(dot(-viewDir, t), dot(-viewDir, b), dot(-viewDir, N));
    if (wo.z < 0.0) {
        wo.z *= -0.25;
        wo = normalize(wo);
    }

    uint quadIndex = uint(((px.x & 1) | (px.y & 1) * 2) + int(camera.frame)) & 3u;
    float surfToHit = length(imageLoad(rtrCandHit, halfPx).xyz);
    float eyeToSurf = length(originVs);
    float eyeRayZScale = -directionWorldToView(viewDir).z;
    vec4 r = imageLoad(reproj, px);
    float squishScale = 16.0 / max(1e-5, eyeToSurf);
    ivec2 previousPx = clamp(ivec2((pixelUv(px) + r.xy) * camera.resolution), ivec2(0), fullSize - 1);
    float rayLenAvg = exponentialUnsquish(mix(
        exponentialSquish(imageLoad(rtrRayLenHistory, previousPx).y, squishScale),
        exponentialSquish(surfToHit, squishScale), 0.1), squishScale);

    // The kernel's size in world units.
    float tanHalfFov = abs(camera.invProj[1][1]);
    float tanTheta = sqrt(alpha) * 0.25;
    float kernelSize;
    {
        float clampedRayLen = max(rayLenAvg, eyeToSurf / max(eyeRayZScale, 1e-3) * tanHalfFov * 0.2 *
                                                 smoothstep(0.0, 0.05 * eyeToSurf, rayLenAvg));
        float kernelVs = clampedRayLen / (clampedRayLen + eyeToSurf);
        kernelSize = kernelVs * eyeToSurf * eyeRayZScale * tanTheta;
        float scale = eyeToSurf * eyeRayZScale * tanHalfFov;
        kernelSize = min(kernelSize, 0.1 * scale);
        kernelSize = max(kernelSize, 4.0 / camera.resolution.y * scale);
    }
    vec3 dominant = specularDominantDirection(N, -viewDir, alpha);
    vec3 reflected = reflect(-dominant, N);
    vec3 kernelT1 = normalize(cross(N, reflected)) * kernelSize;
    vec3 kernelT2 = cross(reflected, kernelT1);

    float blueY = fract(interleavedGradientNoise(vec2(halfPx + 16)) + r2Sequence(camera.frame % 1024u).y);
    const float KERNEL_SHARPNESS = 0.666;
    float radiusSampleMult = 1.0 / pow(float(MAX_SAMPLE_COUNT), KERNEL_SHARPNESS);
    float angleOffset = float((camera.frame * 59u) % 128u) * 1.32471795724474602596;
    vec3 normalVs = directionWorldToView(N);
    bool restir = (settings.stages & STAGE_RTR_RESTIR) != 0u;
    uint sampleCount = restir ? MAX_SAMPLE_COUNT : 1u;

    vec4 accum = vec4(0.0);
    float rayLenAccum = 0.0;
    float radiusAccum = 1.0;
    for (uint i = 1u; i <= sampleCount; ++i, radiusAccum += RADIUS_INC_ON_FAIL) {
        bool isCenter = i == sampleCount;
        ivec2 samplePx;
        if (!restir) {
            samplePx = halfPx;
        } else {
            float angle = (float(i) + angleOffset) * GOLDEN_ANGLE + float(quadIndex) / 4.0 * TAU;
            float jittered = isCenter ? (accum.w > 1e-8 ? blueY : 0.0) : radiusAccum + blueY;
            float radius = pow(jittered, KERNEL_SHARPNESS) * radiusSampleMult;
            vec3 sampleWs = origin + (cos(angle) * kernelT1 + sin(angle) * kernelT2) * radius;
            samplePx = ivec2(floor(worldToUvDepth(sampleWs).xy * camera.resolution / 2.0));
        }
        if (any(lessThan(samplePx, ivec2(0))) || any(greaterThanEqual(samplePx, halfSize))) continue;

        uvec2 raw = imageLoad(rtrReservoirOut, samplePx).xy;
        Reservoir rs = reservoirFromRaw(raw);
        ivec2 spx = payloadPixel(rs.payload);
        if (raw.x == 0u || any(greaterThanEqual(spx, halfSize))) continue;
        vec4 sampleOrigin = imageLoad(rtrRayOrigOut, spx);
        if (sampleOrigin.w > alpha * 2.0) continue;

        vec4 sampleRay = imageLoad(rtrRayOut, spx);
        vec3 sampleHit = sampleRay.xyz + sampleOrigin.xyz;
        vec3 sampleOriginVs = toView(sampleOrigin.xyz);
        vec4 sampleRadiance = imageLoad(rtrRadianceOut, spx);
        float sampleRayPdf = sampleRay.w;
        float neighborPdf = 1.0 / max(rs.W, 1e-20);
        vec3 sampleHitVs = toView(sampleHit);
        vec3 centerToHitVs = sampleHitVs - mix(originVs, sampleOriginVs, NEIGHBOR_ORIGIN_CENTER_BIAS);
        vec3 centerToHitWs = sampleHit - mix(origin, sampleOrigin.xyz, NEIGHBOR_ORIGIN_CENTER_BIAS);
        float sampleCosTheta = decodeCosTheta(sampleRadiance.a);
        float centerToHitDist = length(centerToHitVs);
        float sampleToHitDist = length(sampleHit - sampleOrigin.xyz);

        // Kajiya's correction against halos at edges.
        float pdf0Mult = 1.0, pdf1Mult = 1.0;
        {
            float biased = length(sampleHitVs - mix(originVs, sampleOriginVs,
                                  mix(1.0, NEIGHBOR_ORIGIN_CENTER_BIAS, 0.4 * min(1.0, 3.0 * sqrt(alpha)))));
            pdf0Mult *= max(1e-5, pow(biased / max(sampleToHitDist, 1e-8), 2.0));
            pdf1Mult *= max(1.0, pow(centerToHitDist / max(sampleToHitDist, 1e-8), 2.0));
        }

        vec3 dirWs = normalize(centerToHitWs);
        vec3 wi = vec3(dot(dirWs, t), dot(dirWs, b), dot(dirWs, N));
        if (wi.z < 1e-5) continue;

        float rejection = 1.0;
        vec3 sampleNormalVs = directionWorldToView(imageLoad(gNormal, min(hiPixel(samplePx), fullSize - 1)).xyz);
        rejection *= dot(normalVs, sampleNormalVs) > 0.7 ? 1.0 : 0.0;
        {
            float depthDiff = abs(originVs.z - sampleOriginVs.z) / max(1e-10, kernelSize);
            rejection *= exp2(-max(0.3, normalVs.z) * depthDiff * depthDiff);
        }
        vec3 surfaceOffset = sampleOriginVs - originVs;
        float offsetLength = length(surfaceOffset);
        if (offsetLength > 1e-8 && dot(centerToHitVs, normalVs) * 0.2 / max(centerToHitDist, 1e-8) <
                                   dot(surfaceOffset, normalVs) / offsetLength) {
            rejection *= isCenter ? 1.0 : 0.0;
        }

        SpecularValue spec = specularEvaluate(alpha, F0, wo, wi);
        float specWeight = spec.pdf * step(0.0, wi.z);
        float cosTheta = normalize(wo + wi).z;
        float bentCos = min(sampleCosTheta, cosTheta * 1.25);
        float bentSamplePdf = spec.pdf * ggxNdf(a2, bentCos) / max(ggxNdf(a2, cosTheta), 1e-20);
        float pdfLerp = smoothstep(0.4, 0.7, sqrt(alpha)) * smoothstep(0.0, 0.1, rayLenAvg / eyeToSurf);

        vec3 pdfs[2] = vec3[2](vec3(min(bentSamplePdf, MAX_PDF_CLAMP), neighborPdf * pdf0Mult, 1.0 - pdfLerp),
                               vec3(min(spec.pdf, MAX_PDF_CLAMP), neighborPdf * pdf1Mult, pdfLerp));
        float contribWeight = 0.0;
        for (int k = 0; k < 2; ++k) {
            float misWeight = max(1e-4, spec.pdf / (sampleRayPdf + spec.pdf));
            contribWeight = rejection * misWeight * max(1e-10, specWeight / max(pdfs[k].x, 1e-20));
            accum += vec4(sampleRadiance.rgb * pdfs[k].x / max(pdfs[k].y, 1e-20) * spec.valueOverPdf, 1.0) *
                     contribWeight * pdfs[k].z;
        }
        rayLenAccum += exponentialSquish(surfToHit, squishScale) * contribWeight;
        radiusAccum += 1.0 - RADIUS_INC_ON_FAIL;
    }

    float norm = max(1e-14, accum.w);
    vec3 color = accum.rgb / norm;
    rayLenAccum /= norm;
    vec3 lut = specularLutAt(wo.z, geoRough.w);
    color /= max(F0 * lut.x + lut.y, vec3(1e-4));
    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);

    imageStore(rtrResolved, px, vec4(color, 1.0));
    imageStore(rtrRayLenOut, px, vec4(exponentialUnsquish(rayLenAccum, squishScale), rayLenAvg, 0.0, 0.0));
}
