#version 460
// Copies the scrolled grid back into the grid the lookups use.

#define IRCACHE_SET 0
#include "ircache.glsl"

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 2u * IRCACHE_GRID_CELLS) return;
    ircacheGrid[i] = ircacheGridScrolled[i];
}
