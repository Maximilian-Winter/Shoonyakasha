#version 460
// glslc: --target-env=vulkan1.2
// On validation frames, traces again the ray each reservoir's sample came
// from, in last frame's layout of the half resolution pixels. Where the
// radiance changed, `validityPre` says how much (0 to 1). Where the ray
// still hits about the same point, the sample takes the new radiance; its
// reservoir then forgets history (M) as the light dims, and keeps at most
// ten times its old brightness (through W), to avoid fireflies.

#extension GL_EXT_ray_query : require

#define IRCACHE_SET 0
#include "common.glsl"
#include "ircache.glsl"
#include "lighting.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 5, binding = 0, rgba32f) uniform readonly image2D gPosition;
layout(set = 5, binding = 1, rgba16f) uniform readonly image2D reprojectedGi;
layout(set = 5, binding = 2, rg32ui) uniform uimage2D reservoirHistory;
layout(set = 5, binding = 3, rgba16f) uniform image2D radianceHistory;
layout(set = 5, binding = 4, rgba32f) uniform readonly image2D rayOrigHistory;
layout(set = 5, binding = 5, rgba32f) uniform readonly image2D rayHistory;
layout(set = 5, binding = 6, r16f) uniform writeonly image2D validityPre;

#include "rtdgi_trace.glsl"

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, imageSize(validityPre)))) return;

    float invalidity = 0.0;
    Reservoir r = reservoirFromRaw(imageLoad(reservoirHistory, px).xy);
    if (isValidationFrame() && r.M > 0.0) {
        vec3 previousOrigin = imageLoad(rayOrigHistory, px).xyz;
        vec3 previousHit = imageLoad(rayHistory, px).xyz + previousOrigin;
        vec4 previousRadiance = imageLoad(radianceHistory, px);
        vec3 previous = max(vec3(0.0), previousRadiance.rgb);

        uint rng = hashPixel(px, 0u);
        vec3 toHit = previousHit - previousOrigin;
        float previousDistance = length(toHit);
        DiffuseTrace result = traceDiffuse(previousOrigin, toHit / max(previousDistance, 1e-8), SKY_DIST,
                                           0.03, rng);
        vec3 current = max(vec3(0.0), result.radiance);

        float difference = length(abs(previous - current) / max(vec3(1e-3), previous + current));
        invalidity = smoothstep(0.1, 0.5, difference / length(vec3(1.0)));

        // About the same point: take the new radiance.
        if (abs(result.hitT - previousDistance) / (previousDistance + previousDistance) < 0.2) {
            imageStore(radianceHistory, px, vec4(current, previousRadiance.a));
            float lumOld = luminance(previous), lumNew = luminance(current);
            r.M *= clamp(lumOld / max(1e-8, lumNew), 0.03, 1.0);
            r.W *= clamp(lumOld / max(1e-8, lumNew) * 10.0, 0.01, 1.0);
            imageStore(reservoirHistory, px, uvec4(reservoirRaw(r), 0u, 0u));
        }
    }
    imageStore(validityPre, px, vec4(invalidity));
}
