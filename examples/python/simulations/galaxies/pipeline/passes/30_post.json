{
  "passes": [
    {
      "name": "BloomDown0",
      "type": "graphics",
      "execution": { "type": "fullscreen" },
      "inputs": [{ "resource": "hdrColor", "usage": "shader_read" }],
      "outputs": [{ "resource": "bloomChain", "usage": "color_write", "mip": 0, "clear": [0, 0, 0, 1] }],
      "pipeline": {
        "vertexShader": "../../shaders/fullscreen.vert.spv",
        "fragmentShader": "../../shaders/bloom_down_first.frag.spv",
        "depthTest": false, "depthWrite": false, "cullMode": "none", "vertexInput": "none"
      },
      "descriptorSets": ["bloomDownFirstSet"]
    },
    {
      "name": "BloomDown{m}",
      "type": "graphics",
      "repeat": { "count": 5, "index": "m", "first": 1 },
      "execution": { "type": "fullscreen" },
      "inputs": [{ "resource": "bloomChain", "usage": "shader_read", "mip": "{m-1}" }],
      "outputs": [{ "resource": "bloomChain", "usage": "color_write", "mip": "{m}", "clear": [0, 0, 0, 1] }],
      "pipeline": {
        "vertexShader": "../../shaders/fullscreen.vert.spv",
        "fragmentShader": "../../shaders/bloom_down.frag.spv",
        "depthTest": false, "depthWrite": false, "cullMode": "none", "vertexInput": "none"
      },
      "descriptorSets": ["bloomDown{m}"]
    },
    {
      "name": "BloomUp{m}",
      "type": "graphics",
      "repeat": { "count": 5, "index": "m", "first": 4, "step": -1 },
      "execution": { "type": "fullscreen" },
      "inputs": [{ "resource": "bloomChain", "usage": "shader_read", "mip": "{m+1}" }],
      "outputs": [{ "resource": "bloomChain", "usage": "color_blend", "mip": "{m}" }],
      "pipeline": {
        "vertexShader": "../../shaders/fullscreen.vert.spv",
        "fragmentShader": "../../shaders/bloom_up.frag.spv",
        "depthTest": false, "depthWrite": false, "cullMode": "none", "vertexInput": "none",
        "blending": "additive"
      },
      "descriptorSets": ["bloomUp{m}"]
    },
    {
      "name": "Tonemap",
      "type": "graphics",
      "execution": { "type": "fullscreen" },
      "inputs": [
        { "resource": "hdrColor", "usage": "shader_read" },
        { "resource": "bloomChain", "usage": "shader_read", "mip": 0 }
      ],
      "outputs": [{ "resource": "swapchain", "usage": "color_write", "clear": [0.0, 0.0, 0.0, 1.0] }],
      "pipeline": {
        "vertexShader": "../../shaders/fullscreen.vert.spv",
        "fragmentShader": "../../shaders/tonemap.frag.spv",
        "depthTest": false, "depthWrite": false, "cullMode": "none", "vertexInput": "none"
      },
      "descriptorSets": ["tonemapSet"]
    }
  ]
}
