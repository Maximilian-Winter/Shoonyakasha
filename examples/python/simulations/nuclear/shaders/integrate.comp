#version 450
// One time step from the forces forces.comp wrote: velocity from force,
// then position from velocity (semi-implicit Euler), with damping that
// takes energy out (used to cool nuclei into their ground states).

layout(local_size_x = 128) in;

struct Nucleon {
    vec3 position;
    float type;
    vec3 velocity;
    float energy;
    vec3 force;
    uint nucleusId;
};

layout(std430, binding = 0) buffer Nucleons { Nucleon n[]; } nucleons;

layout(push_constant) uniform Params {
    float dt;
    float damping;
    float mass;
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    vec3 v = nucleons.n[i].velocity + nucleons.n[i].force / pc.mass * pc.dt;
    v *= max(0.0, 1.0 - pc.damping * pc.dt);
    nucleons.n[i].velocity = v;
    nucleons.n[i].position += v * pc.dt;
    nucleons.n[i].energy = 0.5 * pc.mass * dot(v, v);
}
