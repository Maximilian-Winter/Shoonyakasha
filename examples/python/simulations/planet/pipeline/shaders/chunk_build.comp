#version 450
//
// Builds cube-sphere chunks into their slots of ChunkPool: one workgroup per
// job, as cube_sphere.chunk_mesh does on the CPU and in its vertex order.
// The first ROW * ROW vertices are the grid, row by row along u, then rows
// along v; then the four edges' skirts, ROW vertices each (skirtCorner),
// `skirt` metres nearer the planet's centre.
//
// Face coordinates, the cube point, spherify and the position relative to
// the chunk's centre are worked out in 64-bit floats and stored as 32-bit:
// in 32-bit, radius * (direction - centre direction) would carry about a
// centimetre of error at a radius of 100 km.
//

layout(local_size_x = 64) in;

const int MAX_JOBS = 16;
const int QUADS = 16;
const int ROW = QUADS + 1;
const int GRID = ROW * ROW;
const int VERTICES = GRID + 4 * ROW;

layout(set = 0, binding = 0) uniform ChunkJobs {
    vec4 jobA[MAX_JOBS];   // face, level, x, y
    vec4 jobB[MAX_JOBS];   // slot, skirt depth (metres)
    uint jobCount;
    float radius;
} jobs;

struct ChunkVertex {
    vec4 positionU;        // xyz: position relative to the chunk's centre; w: face u
    vec4 normalV;          // xyz: direction from the planet's centre; w: face v
};

layout(std430, set = 0, binding = 1) writeonly buffer ChunkPool {
    ChunkVertex vertices[];
} pool;

// (normal, u axis, v axis) per face: +X, -X, +Y, -Y, +Z, -Z, as cube_sphere.FACES.
const dvec3 FACE_N[6] = dvec3[6](dvec3(1, 0, 0), dvec3(-1, 0, 0), dvec3(0, 1, 0),
                                 dvec3(0, -1, 0), dvec3(0, 0, 1), dvec3(0, 0, -1));
const dvec3 FACE_U[6] = dvec3[6](dvec3(0, 0, -1), dvec3(0, 0, 1), dvec3(1, 0, 0),
                                 dvec3(1, 0, 0), dvec3(1, 0, 0), dvec3(-1, 0, 0));
const dvec3 FACE_V[6] = dvec3[6](dvec3(0, 1, 0), dvec3(0, 1, 0), dvec3(0, 0, -1),
                                 dvec3(0, 0, 1), dvec3(0, 1, 0), dvec3(0, 1, 0));

dvec3 spherify(dvec3 p) {
    dvec3 p2 = p * p;
    return dvec3(p.x * sqrt(1.0LF - 0.5LF * p2.y - 0.5LF * p2.z + p2.y * p2.z / 3.0LF),
                 p.y * sqrt(1.0LF - 0.5LF * p2.z - 0.5LF * p2.x + p2.z * p2.x / 3.0LF),
                 p.z * sqrt(1.0LF - 0.5LF * p2.x - 0.5LF * p2.y + p2.x * p2.y / 3.0LF));
}

dvec3 direction(int face, double u, double v) {
    return spherify(FACE_N[face] + u * FACE_U[face] + v * FACE_V[face]);
}

// Grid coordinates (i, j) of skirt vertex t (0 .. ROW - 1) of edge e, in the
// order cube_sphere.chunk_mesh lays them out: along j = 0 with i rising, along
// i = QUADS with j rising, along j = QUADS with i falling, along i = 0 with j
// falling.
ivec2 skirtCorner(int e, int t) {
    if (e == 0) return ivec2(t, 0);
    if (e == 1) return ivec2(QUADS, t);
    if (e == 2) return ivec2(QUADS - t, QUADS);
    return ivec2(0, QUADS - t);
}

void main() {
    uint job = gl_WorkGroupID.x;
    if (job >= jobs.jobCount) return;
    vec4 a = jobs.jobA[job];
    vec4 b = jobs.jobB[job];
    int face = int(a.x);
    int level = int(a.y);
    int x = int(a.z);
    int y = int(a.w);
    uint slot = uint(b.x);
    double skirt = double(b.y);
    double radius = double(jobs.radius);

    double cells = double(QUADS << level);
    double halfQuads = double(QUADS / 2);
    dvec3 centre = direction(face, -1.0LF + 2.0LF * (double(x * QUADS) + halfQuads) / cells,
                                   -1.0LF + 2.0LF * (double(y * QUADS) + halfQuads) / cells) * radius;

    for (int k = int(gl_LocalInvocationID.x); k < VERTICES; k += 64) {
        ivec2 ij;
        double r = radius;
        if (k < GRID) {
            ij = ivec2(k % ROW, k / ROW);
        } else {
            ij = skirtCorner((k - GRID) / ROW, (k - GRID) % ROW);
            r = radius - skirt;
        }
        double u = -1.0LF + 2.0LF * double(x * QUADS + ij.x) / cells;
        double v = -1.0LF + 2.0LF * double(y * QUADS + ij.y) / cells;
        dvec3 d = direction(face, u, v);
        uint index = slot * uint(VERTICES) + uint(k);
        pool.vertices[index].positionU = vec4(vec3(d * r - centre), float(u));
        pool.vertices[index].normalV = vec4(vec3(d), float(v));
    }
}
