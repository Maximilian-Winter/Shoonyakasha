#version 450
//
// Builds cube-sphere chunks with terrain into their slots of ChunkPool: one
// workgroup per job, in cube_sphere.chunk_mesh's vertex order, on the
// sphere of the job's body's radius, relative to the chunk's centre. The first
// ROW * ROW vertices are the grid, row by row along u, then rows along v;
// then the four edges' skirts, ROW vertices each (skirtCorner), below their
// edge vertex by the job's skirt depth or the grid's height range (highest
// minus lowest), whichever is greater.
//
// Face coordinates, the cube point, spherify and the position relative to
// the chunk's centre are worked out in 64-bit floats and stored as 32-bit:
// in 32-bit, radius * (direction - centre direction) would carry about a
// centimetre of error at a radius of 100 km. Heights are 32-bit, from the
// body's terrain (bodyHeight): body 0, the planet, terrainHeight
// (terrain.glsl); body 1, the moon, moonHeight (moon.glsl).
//
// Each vertex also holds the sine of the terrain's horizon towards the
// sun's azimuth (horizonTowardsSun), for shadows beyond the shadow map.
//
// Each slot's lowest and highest grid height go to ChunkHeights with the
// job's stamp. Workgroup MAX_JOBS evaluates the terrain of the body in
// each probe's w at its direction into ProbeHeights, each with
// probeStamp: probe 1 the planet's natural terrain (terrainHeightNatural).
//

layout(local_size_x = 64) in;

const int MAX_JOBS = 16;
const int PROBES = 128;
const int QUADS = 16;
const int ROW = QUADS + 1;
const int GRID = ROW * ROW;
const int VERTICES = GRID + 4 * ROW;

layout(set = 0, binding = 0) uniform ChunkJobs {
    vec4 jobA[MAX_JOBS];   // face, level, x, y
    vec4 jobB[MAX_JOBS];   // slot, skirt depth (metres), stamp, body
    vec4 probe[PROBES];    // xyz: unit direction; w: the body
    uint jobCount;
    float probeStamp;      // copied to the probes' results
    vec4 radii;            // each body's radius (m), by its index
    vec4 horizonSun;       // xyz: unit direction towards the sun the horizons are measured towards
} jobs;

struct ChunkVertex {
    vec4 positionU;        // xyz: position relative to the chunk's centre; w: face u
    vec4 normalV;          // xyz: surface normal; w: face v
    vec4 radialHeight;     // xyz: direction from the planet's centre; w: height (m)
    vec4 horizon;          // x: sine of the terrain's horizon towards the sun's azimuth
};

layout(std430, set = 0, binding = 1) writeonly buffer ChunkPool {
    ChunkVertex vertices[];
} pool;

layout(set = 0, binding = 2) uniform TerrainParams {
    vec4 continent;
    vec4 mountains;
    vec4 hills;
    vec4 seed;
    vec4 site;
    vec4 siteShape;
    vec4 detail;
} terrain;

layout(std430, set = 0, binding = 3) writeonly buffer ChunkHeights {
    vec4 heights[];        // per slot: lowest, highest grid height (m), stamp
} chunkHeights;

layout(std430, set = 0, binding = 4) writeonly buffer ProbeHeights {
    vec4 probeHeights[];   // per probe: height (m), probeStamp
} probes;

#include "terrain.glsl"
#include "moon.glsl"

const int PLANET = 0;
const int MOON = 1;

// The body this invocation builds or probes, and its radius (m).
int body;
float bodyRadius;

// The terrain's height (m) at unit direction `d` from the centre of `body`.
float bodyHeight(vec3 d) {
    return body == MOON ? moonHeight(d, bodyRadius, 0.0) : terrainHeight(d);
}

// bodyHeight for the normals of a chunk whose vertices are `spacing`
// metres apart: on the moon without the craters whose radius is less than
// two spacings, whose slopes the vertices would sample out of step.
float bodyHeightForNormals(vec3 d, float spacing) {
    return body == MOON ? moonHeight(d, bodyRadius, 2.0 * spacing) : terrainHeight(d);
}

// A height as the surface's: on the planet, below sea level is the sea's surface.
float surfaceHeight(float h) {
    return body == PLANET ? max(h, 0.0) : h;
}

// (normal, u axis, v axis) per face: +X, -X, +Y, -Y, +Z, -Z, as cube_sphere.FACES.
const dvec3 FACE_N[6] = dvec3[6](dvec3(1, 0, 0), dvec3(-1, 0, 0), dvec3(0, 1, 0),
                                 dvec3(0, -1, 0), dvec3(0, 0, 1), dvec3(0, 0, -1));
const dvec3 FACE_U[6] = dvec3[6](dvec3(0, 0, -1), dvec3(0, 0, 1), dvec3(1, 0, 0),
                                 dvec3(1, 0, 0), dvec3(1, 0, 0), dvec3(-1, 0, 0));
const dvec3 FACE_V[6] = dvec3[6](dvec3(0, 1, 0), dvec3(0, 1, 0), dvec3(0, 0, -1),
                                 dvec3(0, 0, 1), dvec3(0, 1, 0), dvec3(0, 1, 0));

shared float sharedLow[64];
shared float sharedHigh[64];

dvec3 spherify(dvec3 p) {
    dvec3 p2 = p * p;
    return dvec3(p.x * sqrt(1.0LF - 0.5LF * p2.y - 0.5LF * p2.z + p2.y * p2.z / 3.0LF),
                 p.y * sqrt(1.0LF - 0.5LF * p2.z - 0.5LF * p2.x + p2.z * p2.x / 3.0LF),
                 p.z * sqrt(1.0LF - 0.5LF * p2.x - 0.5LF * p2.y + p2.x * p2.y / 3.0LF));
}

dvec3 direction(int face, double u, double v) {
    return spherify(FACE_N[face] + u * FACE_U[face] + v * FACE_V[face]);
}

// Grid coordinates (i, j) of skirt vertex t (0 .. ROW - 1) of edge e, in the
// order cube_sphere.chunk_mesh lays them out: along j = 0 with i rising, along
// i = QUADS with j rising, along j = QUADS with i falling, along i = 0 with j
// falling.
ivec2 skirtCorner(int e, int t) {
    if (e == 0) return ivec2(t, 0);
    if (e == 1) return ivec2(QUADS, t);
    if (e == 2) return ivec2(QUADS - t, QUADS);
    return ivec2(0, QUADS - t);
}

// The surface normal at direction `d`, from heights (bodyHeightForNormals)
// `step` radians away along two tangents that depend on `d` alone, so every
// chunk of a level holding `d` gets the same normal.
vec3 surfaceNormal(dvec3 d, double radius, double step) {
    float spacing = float(radius * step * 1.5LF);         // metres between the chunk's vertices, near enough
    dvec3 axis = abs(d.y) < 0.9LF ? dvec3(0, 1, 0) : dvec3(1, 0, 0);
    dvec3 t1 = normalize(cross(axis, d));
    dvec3 t2 = cross(d, t1);
    dvec3 d1 = normalize(d + step * t1), d2 = normalize(d + step * t2);
    dvec3 d3 = normalize(d - step * t1), d4 = normalize(d - step * t2);
    dvec3 p1 = d1 * (radius + double(bodyHeightForNormals(vec3(d1), spacing)));
    dvec3 p2 = d2 * (radius + double(bodyHeightForNormals(vec3(d2), spacing)));
    dvec3 p3 = d3 * (radius + double(bodyHeightForNormals(vec3(d3), spacing)));
    dvec3 p4 = d4 * (radius + double(bodyHeightForNormals(vec3(d4), spacing)));
    return vec3(normalize(cross(p1 - p3, p2 - p4)));
}

// The sine of the terrain's horizon seen from the point at direction `d`
// and height `h`, looking along the ground towards the sun's azimuth
// (jobs.horizonSun): the highest elevation, above the plane square to `d`,
// of the terrain at HORIZON_STEPS distances along the great circle that
// way, spaced evenly in their logarithm from `near` to HORIZON_FAR or
// 0.4 of the radius, whichever is less. On the planet heights below sea
// level count as sea level, both the point's and the terrain's, so the
// sea's surface gets its horizon (surfaceHeight). -1 with the sun
// overhead, where there is no azimuth.
const int HORIZON_STEPS = 20;
const float HORIZON_NEAR = 300.0;
const float HORIZON_FAR = 40000.0;

float horizonTowardsSun(vec3 d, float h, float radius, float near) {
    vec3 sun = jobs.horizonSun.xyz;
    vec3 along = sun - d * dot(sun, d);
    if (dot(along, along) < 1e-8) return -1.0;
    along = normalize(along);
    vec3 from = d * (radius + surfaceHeight(h));
    float far = min(HORIZON_FAR, 0.4 * radius);
    float highest = -1.0;
    for (int i = 0; i < HORIZON_STEPS; ++i) {
        float s = near * pow(far / near, float(i) / float(HORIZON_STEPS - 1));
        float angle = s / radius;
        vec3 dk = d * cos(angle) + along * sin(angle);
        vec3 to = dk * (radius + surfaceHeight(bodyHeight(dk))) - from;
        highest = max(highest, dot(to, d) / length(to));
    }
    return highest;
}

// Writes vertex `k` of `slot`, at grid coordinates `ij`, `below` metres
// under the terrain; returns the terrain's height there. Its horizon is
// measured from two of the chunk's vertex spacings out (at least
// HORIZON_NEAR): finer features cannot be drawn by the chunk's triangles,
// and would make neighbouring vertices' horizons differ by more than they
// can show.
float writeVertex(uint slot, int k, ivec2 ij, int face, int x, int y, double cells, double radius, dvec3 centre,
                  double step, float below) {
    double u = -1.0LF + 2.0LF * double(x * QUADS + ij.x) / cells;
    double v = -1.0LF + 2.0LF * double(y * QUADS + ij.y) / cells;
    dvec3 d = direction(face, u, v);
    float h = bodyHeight(vec3(d));
    double r = radius + double(h) - double(below);
    uint index = slot * uint(VERTICES) + uint(k);
    pool.vertices[index].positionU = vec4(vec3(d * r - centre), float(u));
    pool.vertices[index].normalV = vec4(surfaceNormal(d, radius, step), float(v));
    pool.vertices[index].radialHeight = vec4(vec3(d), h);
    float spacing = float(radius * 2.0LF / cells);        // metres between vertices, near enough
    float near = min(max(HORIZON_NEAR, 2.0 * spacing), 0.2 * float(radius));
    pool.vertices[index].horizon = vec4(horizonTowardsSun(vec3(d), h, float(radius), near), 0.0, 0.0, 0.0);
    return h;
}

void evaluateProbes() {
    for (uint i = gl_LocalInvocationID.x; i < uint(PROBES); i += 64u) {
        vec3 dir = normalize(jobs.probe[i].xyz);
        body = int(jobs.probe[i].w);
        bodyRadius = jobs.radii[body];
        float h = i == 1u ? terrainHeightNatural(dir) : bodyHeight(dir);
        probes.probeHeights[i] = vec4(h, jobs.probeStamp, 0.0, 0.0);
    }
}

void main() {
    uint job = gl_WorkGroupID.x;
    if (job == uint(MAX_JOBS)) {
        evaluateProbes();
        return;
    }
    if (job >= jobs.jobCount) return;
    vec4 a = jobs.jobA[job];
    vec4 b = jobs.jobB[job];
    int face = int(a.x);
    int level = int(a.y);
    int x = int(a.z);
    int y = int(a.w);
    uint slot = uint(b.x);
    float skirt = b.y;
    body = int(b.w);
    bodyRadius = jobs.radii[body];
    double radius = double(bodyRadius);

    double cells = double(QUADS << level);
    double halfQuads = double(QUADS / 2);
    dvec3 centre = direction(face, -1.0LF + 2.0LF * (double(x * QUADS) + halfQuads) / cells,
                                   -1.0LF + 2.0LF * (double(y * QUADS) + halfQuads) / cells) * radius;
    double step = 1.0LF / cells;     // about two thirds of the angle between neighbouring vertices

    // The grid first, then its lowest and highest heights, then the skirts.
    float low = 1e30, high = -1e30;
    for (int k = int(gl_LocalInvocationID.x); k < GRID; k += 64) {
        float h = writeVertex(slot, k, ivec2(k % ROW, k / ROW), face, x, y, cells, radius, centre, step, 0.0);
        low = min(low, h);
        high = max(high, h);
    }

    sharedLow[gl_LocalInvocationID.x] = low;
    sharedHigh[gl_LocalInvocationID.x] = high;
    barrier();
    for (int i = 0; i < 64; ++i) {
        low = min(low, sharedLow[i]);
        high = max(high, sharedHigh[i]);
    }
    if (gl_LocalInvocationID.x == 0u) {
        chunkHeights.heights[slot] = vec4(low, high, b.z, 0.0);
    }

    // A skirt reaches below its edge by at least the grid's height range, the most
    // a coarser neighbour's edge can stand above it there.
    float depth = max(skirt, high - low);
    for (int k = GRID + int(gl_LocalInvocationID.x); k < VERTICES; k += 64) {
        writeVertex(slot, k, skirtCorner((k - GRID) / ROW, (k - GRID) % ROW), face, x, y, cells, radius, centre,
                    step, depth);
    }
}
