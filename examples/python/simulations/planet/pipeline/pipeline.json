{
  "version": 3,
  "name": "planet",
  "vertexFormats": {
    "standard": {
      "attributes": [
        { "name": "position", "type": "vec3", "location": 0 },
        { "name": "color", "type": "vec3", "location": 1 },
        { "name": "texCoord", "type": "vec2", "location": 2 },
        { "name": "normal", "type": "vec3", "location": 3 }
      ]
    },
    "chunkVertex": {
      "attributes": [
        { "name": "positionU", "type": "vec4", "location": 0 },
        { "name": "normalV", "type": "vec4", "location": 1 }
      ]
    }
  },
  "bufferLayouts": {
    "CameraUBO": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "view", "type": "mat4", "source": "scene.camera.view" },
        { "name": "proj", "type": "mat4", "source": "scene.camera.projection" },
        { "name": "sunDirection", "type": "vec4", "source": "scene.custom.planet.sunDirection" }
      ]
    },
    "ChunkJobs": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "jobA", "type": "vec4", "arrayCount": 16, "source": "scene.custom.planet.jobA[i]" },
        { "name": "jobB", "type": "vec4", "arrayCount": 16, "source": "scene.custom.planet.jobB[i]" },
        { "name": "jobCount", "type": "uint", "source": "scene.custom.planet.jobCount", "default": 0 },
        { "name": "radius", "type": "float", "source": "scene.custom.planet.radius" }
      ]
    },
    "ChunkPool": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 731136,
      "fields": [
        { "name": "positionU", "type": "vec4" },
        { "name": "normalV", "type": "vec4" }
      ],
      "target": { "name": "ChunkPool", "readback": { "frequency": "manual" } }
    },
    "ChunkIndices": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 2304,
      "fields": [ { "name": "index", "type": "uint" } ]
    },
    "ChunkInstances": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 2048,
      "fields": [
        { "name": "origin", "type": "vec4" },
        { "name": "colour", "type": "vec4" }
      ]
    },
    "ChunkDraws": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 10244,
      "fields": [ { "name": "word", "type": "uint" } ]
    },
    "MaterialPushConstants": {
      "usage": "push_constant",
      "packing": "scalar",
      "binding": { "offset": 0, "stages": [ "vertex", "fragment" ] },
      "fields": [
        { "name": "model", "type": "mat4", "source": "entity.transform.worldMatrix" },
        { "name": "baseColorFactor", "type": "vec4", "source": "entity.material.params.baseColorFactor" },
        { "name": "gridStrength", "type": "float", "source": "entity.material.params.gridStrength" },
        { "name": "padding0", "type": "float", "source": "const.0" },
        { "name": "padding1", "type": "float", "source": "const.0" },
        { "name": "padding2", "type": "float", "source": "const.0" }
      ]
    }
  },
  "entityDataBindings": {
    "opaque": {
      "perDraw": { "layoutRef": "MaterialPushConstants" },
      "material": { "layoutRef": "materialSet" }
    }
  },
  "descriptorSetLayouts": {
    "cameraSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "vertex", "fragment" ], "name": "CameraUBO",
          "autoBindBuffer": "CameraUBO" }
      ]
    },
    "chunkBuildSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "compute" ], "name": "ChunkJobs",
          "autoBindBuffer": "ChunkJobs" },
        { "binding": 1, "type": "storage_buffer", "stages": [ "compute" ], "name": "ChunkPool",
          "autoBindBuffer": "ChunkPool" }
      ]
    },
    "chunkInstanceSet": {
      "bindings": [
        { "binding": 0, "type": "storage_buffer", "stages": [ "vertex" ], "name": "ChunkInstances",
          "autoBindBuffer": "ChunkInstances" }
      ]
    },
    "materialSet": {
      "bindings": [
        { "binding": 0, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "albedoMap" }
      ]
    }
  },
  "resources": [
    { "name": "swapchain", "kind": "image", "imported": true },
    { "name": "depth", "kind": "image", "image": { "format": "D32_SFLOAT" } }
  ],
  "passes": [
    {
      "name": "BuildChunks",
      "type": "compute",
      "execution": {
        "type": "compute_dispatch",
        "workgroupSize": [ 64, 1, 1 ],
        "dispatch": { "x": 16, "y": 1, "z": 1 }
      },
      "pipeline": { "computeShader": "shaders/chunk_build.comp.spv" },
      "descriptorSets": [ "chunkBuildSet" ],
      "hasSideEffects": true
    },
    {
      "name": "Terrain",
      "type": "graphics",
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "ChunkPool" },
        "indexBuffer": { "buffer": "ChunkIndices", "type": "uint32" },
        "arguments": { "buffer": "ChunkDraws", "offset": 16 },
        "count": { "buffer": "ChunkDraws", "offset": 0, "maxDrawCount": 2048 }
      },
      "pipeline": {
        "vertexShader": "shaders/terrain.vert.spv",
        "fragmentShader": "shaders/terrain.frag.spv",
        "vertexInput": "chunkVertex",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back"
      },
      "descriptorSets": [ "cameraSet", "chunkInstanceSet" ],
      "outputs": [
        { "resource": "swapchain", "usage": "color_write", "clear": [ 0.0, 0.0, 0.0, 1.0 ] },
        { "resource": "depth", "usage": "depth_write", "clear": { "depth": 0.0, "stencil": 0 } }
      ]
    },
    {
      "name": "Blocks",
      "type": "graphics",
      "execution": {
        "type": "opaque_geometry",
        "sortMode": "front_to_back",
        "entityDataBinding": "opaque"
      },
      "pipeline": {
        "vertexShader": "shaders/scene.vert.spv",
        "fragmentShader": "shaders/scene.frag.spv",
        "vertexInput": "standard",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back"
      },
      "descriptorSets": [ "cameraSet", "materialSet" ],
      "pushConstants": [ { "stages": [ "vertex", "fragment" ], "size": 96, "offset": 0 } ],
      "outputs": [
        { "resource": "swapchain", "usage": "color_write" },
        { "resource": "depth", "usage": "depth_write" }
      ]
    },
    {
      "name": "Wireframe",
      "type": "graphics",
      "enabled": false,
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "ChunkPool" },
        "indexBuffer": { "buffer": "ChunkIndices", "type": "uint32" },
        "arguments": { "buffer": "ChunkDraws", "offset": 16 },
        "count": { "buffer": "ChunkDraws", "offset": 0, "maxDrawCount": 2048 }
      },
      "pipeline": {
        "vertexShader": "shaders/terrain.vert.spv",
        "fragmentShader": "shaders/wire.frag.spv",
        "vertexInput": "chunkVertex",
        "depthTest": true,
        "depthWrite": false,
        "depthCompareOp": "greater_or_equal",
        "depthBias": { "slope": 1.5 },
        "cullMode": "back",
        "wireframe": true
      },
      "descriptorSets": [ "cameraSet", "chunkInstanceSet" ],
      "outputs": [
        { "resource": "swapchain", "usage": "color_blend" },
        { "resource": "depth", "usage": "depth_read" }
      ]
    },
    {
      "name": "UIOverlay",
      "type": "graphics",
      "execution": { "type": "ui_canvas" },
      "outputs": [ { "resource": "swapchain", "usage": "color_blend", "present": true } ]
    }
  ]
}
