{
  "version": 3,
  "name": "planet",
  "vertexFormats": {
    "standard": {
      "attributes": [
        { "name": "position", "type": "vec3", "location": 0 },
        { "name": "color", "type": "vec3", "location": 1 },
        { "name": "texCoord", "type": "vec2", "location": 2 },
        { "name": "normal", "type": "vec3", "location": 3 }
      ]
    },
    "chunkVertex": {
      "attributes": [
        { "name": "positionU", "type": "vec4", "location": 0 },
        { "name": "normalV", "type": "vec4", "location": 1 },
        { "name": "radialHeight", "type": "vec4", "location": 2 }
      ]
    },
    "orbitVertex": {
      "attributes": [
        { "name": "position", "type": "vec4", "location": 0 }
      ]
    }
  },
  "bufferLayouts": {
    "CameraUBO": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "view", "type": "mat4", "source": "scene.camera.view" },
        { "name": "proj", "type": "mat4", "source": "scene.camera.projection" },
        { "name": "sunDirection", "type": "vec4", "source": "scene.custom.planet.sunDirection" },
        { "name": "invView", "type": "mat4", "source": "scene.camera.invView" },
        { "name": "invProj", "type": "mat4", "source": "scene.camera.invProj" },
        { "name": "cameraFromCentre", "type": "vec4", "source": "scene.custom.planet.cameraFromCentre" },
        { "name": "time", "type": "float", "source": "scene.time.elapsed" }
      ]
    },
    "AtmosphereParams": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "radii", "type": "vec4", "source": "scene.custom.planet.atmosphere.radii",
          "default": [ 100000.0, 120000.0, 2500.0, 400.0 ] },
        { "name": "rayleigh", "type": "vec4", "source": "scene.custom.planet.atmosphere.rayleigh",
          "default": [ 1.857e-5, 4.339e-5, 1.0592e-4, 0.8 ] },
        { "name": "mie", "type": "vec4", "source": "scene.custom.planet.atmosphere.mie",
          "default": [ 1.279e-5, 1.408e-5, 20.0, 0.4 ] },
        { "name": "sun", "type": "vec4", "source": "scene.custom.planet.sunDirection" },
        { "name": "ozone", "type": "vec4", "source": "scene.custom.planet.atmosphere.ozone",
          "default": [ 2.08e-6, 6.02e-6, 2.72e-7, 7800.0 ] },
        { "name": "settings", "type": "vec4", "source": "scene.custom.planet.atmosphere.settings",
          "default": [ 4700.0, 1.0, 0.0, 0.0 ] }
      ]
    },
    "TerrainParams": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "continent", "type": "vec4", "source": "scene.custom.planet.terrain.continent",
          "default": [ 1.5, 0.6, 0.05, 800.0 ] },
        { "name": "mountains", "type": "vec4", "source": "scene.custom.planet.terrain.mountains",
          "default": [ 6.0, 3000.0, 2.0, 8.0 ] },
        { "name": "hills", "type": "vec4", "source": "scene.custom.planet.terrain.hills",
          "default": [ 40.0, 150.0, 1500.0, 6.0 ] },
        { "name": "seed", "type": "vec4", "source": "scene.custom.planet.terrain.seed",
          "default": [ 0.0, 0.0, 0.0, 0.0 ] },
        { "name": "site", "type": "vec4", "source": "scene.custom.planet.terrain.site",
          "default": [ 0.0, 0.0, 1.0, 0.0 ] },
        { "name": "siteShape", "type": "vec4", "source": "scene.custom.planet.terrain.siteShape",
          "default": [ 150.0, 600.0, 100000.0, 0.0 ] },
        { "name": "detail", "type": "vec4", "source": "scene.custom.planet.terrain.detail",
          "default": [ 80.0, 15.0, 4.0, 0.5 ] }
      ]
    },
    "ChunkJobs": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "jobA", "type": "vec4", "arrayCount": 16, "source": "scene.custom.planet.jobA[i]" },
        { "name": "jobB", "type": "vec4", "arrayCount": 16, "source": "scene.custom.planet.jobB[i]" },
        { "name": "probe", "type": "vec4", "arrayCount": 128, "source": "scene.custom.planet.probe[i]" },
        { "name": "jobCount", "type": "uint", "source": "scene.custom.planet.jobCount", "default": 0 },
        { "name": "radius", "type": "float", "source": "scene.custom.planet.radius" }
      ]
    },
    "ChunkPool": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 731136,
      "fields": [
        { "name": "positionU", "type": "vec4" },
        { "name": "normalV", "type": "vec4" },
        { "name": "radialHeight", "type": "vec4" }
      ],
      "target": { "name": "ChunkPool", "readback": { "frequency": "manual" } }
    },
    "ChunkHeights": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 2048,
      "fields": [ { "name": "lowHighStamp", "type": "vec4" } ],
      "target": { "name": "ChunkHeights", "readback": { "frequency": "per_frame" } }
    },
    "ProbeHeights": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 128,
      "fields": [ { "name": "height", "type": "vec4" } ],
      "target": { "name": "ProbeHeights", "readback": { "frequency": "per_frame" } }
    },
    "ChunkIndices": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 2304,
      "fields": [ { "name": "index", "type": "uint" } ]
    },
    "ChunkInstances": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 2048,
      "fields": [
        { "name": "origin", "type": "vec4" },
        { "name": "colour", "type": "vec4" },
        { "name": "morph", "type": "vec4" }
      ]
    },
    "ChunkDraws": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 10244,
      "fields": [ { "name": "word", "type": "uint" } ]
    },
    "OceanDraws": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 10244,
      "fields": [ { "name": "word", "type": "uint" } ]
    },
    "OrbitPoints": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 256,
      "fields": [ { "name": "position", "type": "vec4" } ]
    },
    "OrbitIndices": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 256,
      "fields": [ { "name": "index", "type": "uint" } ]
    },
    "OrbitDraws": {
      "usage": "storage_buffer",
      "packing": "std430",
      "elementCount": 9,
      "fields": [ { "name": "word", "type": "uint" } ]
    },
    "MaterialPushConstants": {
      "usage": "push_constant",
      "packing": "scalar",
      "binding": { "offset": 0, "stages": [ "vertex", "fragment" ] },
      "fields": [
        { "name": "model", "type": "mat4", "source": "entity.transform.worldMatrix" },
        { "name": "baseColorFactor", "type": "vec4", "source": "entity.material.params.baseColorFactor" },
        { "name": "gridStrength", "type": "float", "source": "entity.material.params.gridStrength" },
        { "name": "padding0", "type": "float", "source": "const.0" },
        { "name": "padding1", "type": "float", "source": "const.0" },
        { "name": "padding2", "type": "float", "source": "const.0" },
        { "name": "emissiveFactor", "type": "vec4", "source": "entity.material.params.emissiveFactor",
          "default": [ 0.0, 0.0, 0.0, 0.0 ] }
      ]
    },
    "HudParams": {
      "usage": "uniform_buffer",
      "packing": "std140",
      "updateFrequency": "per_frame",
      "fields": [
        { "name": "up", "type": "vec4", "source": "scene.custom.planet.hud.up", "default": [ 0.0, 1.0, 0.0, 0.0 ] },
        { "name": "prograde", "type": "vec4", "source": "scene.custom.planet.hud.prograde",
          "default": [ 0.0, 0.0, -1.0, 0.0 ] },
        { "name": "colour", "type": "vec4", "source": "scene.custom.planet.hud.colour",
          "default": [ 0.35, 1.0, 0.45, 1.0 ] },
        { "name": "reentry", "type": "vec4", "source": "scene.custom.planet.hud.reentry",
          "default": [ 0.0, 0.0, 0.0, 0.0 ] }
      ]
    }
  },
  "entityDataBindings": {
    "opaque": {
      "perDraw": { "layoutRef": "MaterialPushConstants" },
      "material": { "layoutRef": "materialSet" }
    }
  },
  "descriptorSetLayouts": {
    "cameraSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "vertex", "fragment" ], "name": "CameraUBO",
          "autoBindBuffer": "CameraUBO" },
        { "binding": 1, "type": "uniform_buffer", "stages": [ "fragment" ], "name": "TerrainParams",
          "autoBindBuffer": "TerrainParams" },
        { "binding": 2, "type": "uniform_buffer", "stages": [ "fragment" ], "name": "AtmosphereParams",
          "autoBindBuffer": "AtmosphereParams" },
        { "binding": 3, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "transmittanceLut",
          "autoBindResource": "transmittanceLut", "autoBindSampler": "linearClamp" },
        { "binding": 4, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "multiScatteringLut",
          "autoBindResource": "multiScatteringLut", "autoBindSampler": "linearClamp" }
      ]
    },
    "transmittanceLutSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "compute" ], "name": "AtmosphereParams",
          "autoBindBuffer": "AtmosphereParams" },
        { "binding": 1, "type": "storage_image", "stages": [ "compute" ], "name": "transmittanceImage",
          "autoBindResource": "transmittanceLut" }
      ]
    },
    "multiScatteringLutSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "compute" ], "name": "AtmosphereParams",
          "autoBindBuffer": "AtmosphereParams" },
        { "binding": 1, "type": "combined_image_sampler", "stages": [ "compute" ], "name": "transmittanceLut",
          "autoBindResource": "transmittanceLut", "autoBindSampler": "linearClamp" },
        { "binding": 2, "type": "storage_image", "stages": [ "compute" ], "name": "multiScatteringImage",
          "autoBindResource": "multiScatteringLut" }
      ]
    },
    "atmosphereInputSet": {
      "bindings": [
        { "binding": 0, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "hdrColor",
          "autoBindResource": "hdrColor", "autoBindSampler": "nearestClamp" },
        { "binding": 1, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "sceneDepth",
          "autoBindResource": "depth", "autoBindSampler": "nearestClamp" }
      ]
    },
    "chunkBuildSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "compute" ], "name": "ChunkJobs",
          "autoBindBuffer": "ChunkJobs" },
        { "binding": 1, "type": "storage_buffer", "stages": [ "compute" ], "name": "ChunkPool",
          "autoBindBuffer": "ChunkPool" },
        { "binding": 2, "type": "uniform_buffer", "stages": [ "compute" ], "name": "TerrainParams",
          "autoBindBuffer": "TerrainParams" },
        { "binding": 3, "type": "storage_buffer", "stages": [ "compute" ], "name": "ChunkHeights",
          "autoBindBuffer": "ChunkHeights" },
        { "binding": 4, "type": "storage_buffer", "stages": [ "compute" ], "name": "ProbeHeights",
          "autoBindBuffer": "ProbeHeights" }
      ]
    },
    "chunkInstanceSet": {
      "bindings": [
        { "binding": 0, "type": "storage_buffer", "stages": [ "vertex" ], "name": "ChunkInstances",
          "autoBindBuffer": "ChunkInstances" },
        { "binding": 1, "type": "storage_buffer", "stages": [ "vertex" ], "name": "ChunkPool",
          "autoBindBuffer": "ChunkPool" }
      ]
    },
    "materialSet": {
      "bindings": [
        { "binding": 0, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "albedoMap" },
        { "binding": 1, "type": "combined_image_sampler", "stages": [ "fragment" ], "name": "emissiveMap" }
      ]
    },
    "hudSet": {
      "bindings": [
        { "binding": 0, "type": "uniform_buffer", "stages": [ "fragment" ], "name": "HudParams",
          "autoBindBuffer": "HudParams" }
      ]
    }
  },
  "samplers": {
    "nearestClamp": { "magFilter": "nearest", "minFilter": "nearest", "mipmapMode": "nearest",
                      "addressMode": "clamp_to_edge" },
    "linearClamp": { "magFilter": "linear", "minFilter": "linear", "addressMode": "clamp_to_edge" }
  },
  "resources": [
    { "name": "swapchain", "kind": "image", "imported": true },
    { "name": "hdrColor", "kind": "image", "image": { "format": "R16G16B16A16_SFLOAT" } },
    { "name": "depth", "kind": "image", "image": { "format": "D32_SFLOAT" } },
    { "name": "transmittanceLut", "kind": "image",
      "image": { "format": "R16G16B16A16_SFLOAT", "width": 256, "height": 64 } },
    { "name": "multiScatteringLut", "kind": "image",
      "image": { "format": "R16G16B16A16_SFLOAT", "width": 32, "height": 32 } }
  ],
  "passes": [
    {
      "name": "TransmittanceLut",
      "type": "compute",
      "execution": {
        "type": "compute_dispatch",
        "workgroupSize": [ 8, 8, 1 ],
        "dispatch": { "x": 32, "y": 8, "z": 1 }
      },
      "pipeline": { "computeShader": "shaders/transmittance_lut.comp.spv" },
      "descriptorSets": [ "transmittanceLutSet" ],
      "outputs": [ { "resource": "transmittanceLut", "usage": "storage_image_write" } ]
    },
    {
      "name": "MultiScatteringLut",
      "type": "compute",
      "execution": {
        "type": "compute_dispatch",
        "workgroupSize": [ 8, 8, 1 ],
        "dispatch": { "x": 4, "y": 4, "z": 1 }
      },
      "pipeline": { "computeShader": "shaders/multi_scattering_lut.comp.spv" },
      "descriptorSets": [ "multiScatteringLutSet" ],
      "inputs": [ { "resource": "transmittanceLut", "usage": "shader_read" } ],
      "outputs": [ { "resource": "multiScatteringLut", "usage": "storage_image_write" } ]
    },
    {
      "name": "BuildChunks",
      "type": "compute",
      "execution": {
        "type": "compute_dispatch",
        "workgroupSize": [ 64, 1, 1 ],
        "dispatch": { "x": 17, "y": 1, "z": 1 }
      },
      "pipeline": { "computeShader": "shaders/chunk_build.comp.spv" },
      "descriptorSets": [ "chunkBuildSet" ],
      "hasSideEffects": true
    },
    {
      "name": "Terrain",
      "type": "graphics",
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "ChunkPool" },
        "indexBuffer": { "buffer": "ChunkIndices", "type": "uint32" },
        "arguments": { "buffer": "ChunkDraws", "offset": 16 },
        "count": { "buffer": "ChunkDraws", "offset": 0, "maxDrawCount": 2048 }
      },
      "pipeline": {
        "vertexShader": "shaders/terrain.vert.spv",
        "fragmentShader": "shaders/terrain.frag.spv",
        "vertexInput": "chunkVertex",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back"
      },
      "descriptorSets": [ "cameraSet", "chunkInstanceSet" ],
      "inputs": [
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "outputs": [
        { "resource": "hdrColor", "usage": "color_write", "clear": [ 0.0, 0.0, 0.0, 1.0 ] },
        { "resource": "depth", "usage": "depth_write", "clear": { "depth": 0.0, "stencil": 0 } }
      ]
    },
    {
      "name": "Blocks",
      "type": "graphics",
      "execution": {
        "type": "opaque_geometry",
        "sortMode": "front_to_back",
        "entityDataBinding": "opaque",
        "renderLayerMask": 1
      },
      "pipeline": {
        "vertexShader": "shaders/scene.vert.spv",
        "fragmentShader": "shaders/scene.frag.spv",
        "vertexInput": "standard",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back"
      },
      "descriptorSets": [ "cameraSet", "materialSet" ],
      "pushConstants": [ { "stages": [ "vertex", "fragment" ], "size": 112, "offset": 0 } ],
      "inputs": [
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "outputs": [
        { "resource": "hdrColor", "usage": "color_write" },
        { "resource": "depth", "usage": "depth_write" }
      ]
    },
    {
      "name": "Screens",
      "type": "graphics",
      "execution": {
        "type": "opaque_geometry",
        "entityDataBinding": "opaque",
        "renderLayerMask": 2
      },
      "pipeline": {
        "vertexShader": "shaders/scene.vert.spv",
        "fragmentShader": "shaders/screen.frag.spv",
        "vertexInput": "standard",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back"
      },
      "descriptorSets": [ "cameraSet", "materialSet" ],
      "pushConstants": [ { "stages": [ "vertex", "fragment" ], "size": 112, "offset": 0 } ],
      "inputs": [
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "outputs": [
        { "resource": "hdrColor", "usage": "color_write" },
        { "resource": "depth", "usage": "depth_write" }
      ]
    },
    {
      "name": "Ocean",
      "type": "graphics",
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "ChunkPool" },
        "indexBuffer": { "buffer": "ChunkIndices", "type": "uint32" },
        "arguments": { "buffer": "OceanDraws", "offset": 16 },
        "count": { "buffer": "OceanDraws", "offset": 0, "maxDrawCount": 2048 }
      },
      "pipeline": {
        "vertexShader": "shaders/ocean.vert.spv",
        "fragmentShader": "shaders/ocean.frag.spv",
        "vertexInput": "chunkVertex",
        "depthTest": true,
        "depthWrite": true,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "back",
        "blending": "custom",
        "srcColorFactor": "one",
        "dstColorFactor": "one_minus_src_alpha"
      },
      "descriptorSets": [ "cameraSet", "chunkInstanceSet" ],
      "inputs": [
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "outputs": [
        { "resource": "hdrColor", "usage": "color_blend" },
        { "resource": "depth", "usage": "depth_write" }
      ]
    },
    {
      "name": "Wireframe",
      "type": "graphics",
      "enabled": false,
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "ChunkPool" },
        "indexBuffer": { "buffer": "ChunkIndices", "type": "uint32" },
        "arguments": { "buffer": "ChunkDraws", "offset": 16 },
        "count": { "buffer": "ChunkDraws", "offset": 0, "maxDrawCount": 2048 }
      },
      "pipeline": {
        "vertexShader": "shaders/terrain.vert.spv",
        "fragmentShader": "shaders/wire.frag.spv",
        "vertexInput": "chunkVertex",
        "depthTest": true,
        "depthWrite": false,
        "depthCompareOp": "greater_or_equal",
        "depthBias": { "slope": 1.5 },
        "cullMode": "back",
        "wireframe": true
      },
      "descriptorSets": [ "cameraSet", "chunkInstanceSet" ],
      "inputs": [
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "outputs": [
        { "resource": "hdrColor", "usage": "color_blend" },
        { "resource": "depth", "usage": "depth_read" }
      ]
    },
    {
      "name": "Atmosphere",
      "type": "graphics",
      "execution": { "type": "fullscreen" },
      "inputs": [
        { "resource": "hdrColor", "usage": "shader_read" },
        { "resource": "depth", "usage": "shader_read" },
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "pipeline": {
        "vertexShader": "shaders/fullscreen.vert.spv",
        "fragmentShader": "shaders/atmosphere.frag.spv",
        "vertexInput": "none",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none"
      },
      "descriptorSets": [ "cameraSet", "atmosphereInputSet" ],
      "outputs": [ { "resource": "swapchain", "usage": "color_write" } ]
    },
    {
      "name": "ReentryGlow",
      "type": "graphics",
      "enabled": false,
      "execution": { "type": "fullscreen" },
      "inputs": [
        { "resource": "hdrColor", "usage": "shader_read" },
        { "resource": "depth", "usage": "shader_read" },
        { "resource": "transmittanceLut", "usage": "shader_read" },
        { "resource": "multiScatteringLut", "usage": "shader_read" }
      ],
      "pipeline": {
        "vertexShader": "shaders/fullscreen.vert.spv",
        "fragmentShader": "shaders/reentry.frag.spv",
        "vertexInput": "none",
        "depthTest": false,
        "depthWrite": false,
        "cullMode": "none",
        "blending": "additive"
      },
      "descriptorSets": [ "cameraSet", "hudSet", "atmosphereInputSet" ],
      "outputs": [ { "resource": "swapchain", "usage": "color_blend" } ]
    },
    {
      "name": "OrbitPath",
      "type": "graphics",
      "execution": {
        "type": "draw_indexed_indirect",
        "vertexBuffer": { "buffer": "OrbitPoints" },
        "indexBuffer": { "buffer": "OrbitIndices", "type": "uint32" },
        "arguments": { "buffer": "OrbitDraws", "offset": 16 },
        "count": { "buffer": "OrbitDraws", "offset": 0, "maxDrawCount": 1 }
      },
      "pipeline": {
        "vertexShader": "shaders/orbit.vert.spv",
        "fragmentShader": "shaders/orbit.frag.spv",
        "vertexInput": "orbitVertex",
        "topology": "line_strip",
        "lineWidth": 2.0,
        "depthTest": true,
        "depthWrite": false,
        "depthCompareOp": "greater_or_equal",
        "cullMode": "none",
        "blending": "custom",
        "srcColorFactor": "src_alpha",
        "dstColorFactor": "one_minus_src_alpha"
      },
      "descriptorSets": [ "cameraSet" ],
      "inputs": [
