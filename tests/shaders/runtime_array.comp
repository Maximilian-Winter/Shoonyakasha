#version 450
//
// Fixture for ShaderInterfaceValidatorTest: a storage block ending in a
// runtime array of structs, which a JSON layout cannot describe member by
// member.
//

layout(local_size_x = 64) in;

struct Particle {
    vec4 position;
    vec4 velocity;
};

layout(set = 0, binding = 0) buffer Particles {
    Particle particles[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    particles[i].position += particles[i].velocity;
}
